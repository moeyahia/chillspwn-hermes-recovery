[Unit]
Description=Hermes Gateway (unprivileged message adapters and scheduler)
After=network-online.target tailscaled.service
Wants=network-online.target
RequiresMountsFor=/var/lib/chillspwn/workspaces/htb/boxes /var/lib/chillspwn/workspaces/engagements

[Service]
Type=simple
User=chillspwn
Group=chillspwn
SupplementaryGroups=
Environment=HOME=/home/chillspwn
Environment=HERMES_HOME=/var/lib/chillspwn/hermes
Environment=HERMES_PYTHON=/opt/chillspwn-runtime/hermes-venv/bin/python
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/chillspwn-bin:/opt/chillspwn-runtime/hermes-venv/bin:/opt/chillspwn-runtime/bin:/opt/chillspwn/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/chillspwn/chillspwn.env
EnvironmentFile=-/etc/hermes-gateway.env
WorkingDirectory=/var/lib/chillspwn/hermes
ExecStart=/opt/chillspwn-runtime/hermes-venv/bin/python -m hermes_cli.main gateway run --replace
Restart=always
RestartSec=5
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=240
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=append:/var/log/chillspwn/hermes-gateway.log
StandardError=append:/var/log/chillspwn/hermes-gateway.log

[Install]
WantedBy=multi-user.target
