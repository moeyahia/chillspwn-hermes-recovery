[Unit]
Description=ChillsPwn Command OS V2 Preview
After=network-online.target tailscaled.service
Wants=network-online.target
RequiresMountsFor=/var/lib/chillspwn/workspaces/htb/boxes /var/lib/chillspwn/workspaces/engagements

[Service]
Type=simple
User=chillspwn
Group=chillspwn
SupplementaryGroups=
WorkingDirectory=/opt/chillspwn/plugin-command-os-v2/webapp
Environment=HOME=/home/chillspwn
Environment=NODE_ENV=production
Environment=CHILLSPWN_PORT=3132
Environment=PATH=/opt/chillspwn-runtime/bin:/opt/chillspwn-runtime/hermes-venv/bin:/opt/chillspwn/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CHILLSPWN_BUN_BIN=/opt/chillspwn-runtime/bin/bun
Environment=GROK_COMMANDER_BUN=/opt/chillspwn-runtime/bin/bun
Environment=CHILLSPWN_PLUGIN_DIR=/opt/chillspwn/plugin-command-os-v2
Environment=CHILLSPWN_REPORT_TEMPLATE_DIR=/opt/chillspwn/report-template
Environment=CHILLSPWN_STATE_DIR=/var/lib/chillspwn/state-v2-preview
Environment=CHILLSPWN_SESSIONS_DIR=/var/lib/chillspwn/state-v2-preview/sessions
Environment=CHILLSPWN_PERSONAS_DIR=/opt/chillspwn/plugin-command-os-v2/webapp/server/agents/personas
Environment=COMMAND_OS_DB_PATH=/var/lib/chillspwn/command-os-v2.sqlite
Environment=COMMAND_OS_V2_TOOL_EVIDENCE_PATH=/var/lib/chillspwn-attestations/command-os-v2-tool-evidence.json
Environment=COMMAND_OS_V2_KILL_SWITCH=false
Environment=CHILLSPWN_VAULT_ROOT=/var/lib/chillspwn/brain-vaults
Environment=HERMES_HOME=/var/lib/chillspwn/hermes
Environment=HERMES_PYTHON=/opt/chillspwn-runtime/hermes-venv/bin/python
Environment=CLAUDE_CONFIG_DIR=/var/lib/chillspwn/claude
Environment=CLAUDE_BIN=/usr/local/bin/claude
Environment=CODEX_HOME=/var/lib/chillspwn/codex
Environment=CODEX_BIN=/usr/local/bin/codex
Environment=GROK_HOME=/var/lib/chillspwn/grok-home
Environment=GROK_AUTH_PATH=/var/lib/chillspwn/grok-auth/auth.json
Environment=GROK_BIN=/opt/chillspwn/bin/grok
Environment=CHILLSPWN_OR_WARM=1
Environment=MCP_ARSENAL_ALLOW_DOCKER=false
Environment=APPROVAL_MODE=human
Environment=ALLOWED_WORKSPACE_ROOTS=/var/lib/chillspwn/workspaces/htb/boxes,/var/lib/chillspwn/workspaces/engagements
EnvironmentFile=-/etc/chillspwn/chillspwn.env
ExecStart=/opt/chillspwn-runtime/bin/bun run --no-hot server/command-os-v2-preview-entry.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0077
LimitNOFILE=65536
Nice=5
CPUWeight=25
CPUQuota=200%
IOWeight=25
MemoryHigh=6G
MemoryMax=10G
TasksMax=1024
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
StandardOutput=append:/var/log/chillspwn/command-os-v2-preview.log
StandardError=append:/var/log/chillspwn/command-os-v2-preview.log

[Install]
WantedBy=multi-user.target
