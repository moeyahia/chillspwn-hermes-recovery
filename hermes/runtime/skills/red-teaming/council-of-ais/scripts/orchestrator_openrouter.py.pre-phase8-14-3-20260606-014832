# ── Skills: give the OpenRouter model the same SKILL.md playbooks the Claude path has. We put a
# compact INDEX (name + description) in context and expose a use_skill(name) tool that loads the
# full SKILL.md on demand — so DeepSeek can pull up the HTB privesc chains, the AI council, GPU
# cracking, recon pipeline, report gen, etc. and FOLLOW them, without bloating the prompt with
# every skill's full text. The curated plugin skills are indexed; use_skill can load from either tree.
SKILLS_DIRS = [
    os.path.expanduser("~/.claude/plugins/chillspwn/skills"),   # curated, user-facing → indexed
    os.path.expanduser("~/.hermes/skills"),                     # learning/knowledge tree → loadable
]
_SKILL_NAME_RE = re.compile(r"^name:\s*(.+?)\s*$", re.M)
_SKILL_DESC_RE = re.compile(r"^description:\s*(.+?)\s*$", re.M)

def _skill_frontmatter(md_path):
    try:
        with open(md_path, encoding="utf-8", errors="replace") as f:
            head = f.read(4000)
    except Exception:
        return None, None
    n = _SKILL_NAME_RE.search(head)
    d = _SKILL_DESC_RE.search(head)
    return (n.group(1).strip() if n else None), (d.group(1).strip() if d else None)

def scan_skills_index():
    """Index the CURATED plugin skills (dir 0): [(name, description)], sorted, deduped."""
    out = {}
    try:
        base = SKILLS_DIRS[0]
        for entry in sorted(os.listdir(base)):
            md = os.path.join(base, entry, "SKILL.md")
            if os.path.isfile(md):
                name, desc = _skill_frontmatter(md)
                out.setdefault(name or entry, desc or "")
    except Exception:
        pass
    return list(out.items())

def render_skills_index(skills):
    if not skills:
        return ""
    lines = ["## AVAILABLE SKILLS — call use_skill(\"<name>\") to load the full playbook, then FOLLOW it.",
             "(Battle-tested workflows. When one matches your objective, LOAD it before improvising.)"]
    lines += [f"- {n}: {d}" for n, d in skills]
    return "\n".join(lines)

def load_skill_text(skill_name):
    """Find a skill by directory- or frontmatter-name across both trees; return SKILL.md (capped)."""
    want = (skill_name or "").strip().lower()
    if not want:
        return "Error: no skill name given. See the AVAILABLE SKILLS list."
    for base in SKILLS_DIRS:
        try:
            entries = os.listdir(base)
        except Exception:
            continue
        for entry in entries:
            md = os.path.join(base, entry, "SKILL.md")
            if not os.path.isfile(md):
                continue
            nm, _ = _skill_frontmatter(md)
            if entry.lower() == want or (nm and nm.strip().lower() == want):
                try:
                    with open(md, encoding="utf-8", errors="replace") as f:
                        body = f.read(20000)
                    # Like Hermes' skill message: tell the model the skill's directory so it can
                    # resolve relative paths (scripts/…, references/…, templates/…) and run them.
                    skill_dir = os.path.join(base, entry)
                    return (f"[skill: {skill_name}]\n"
                            f"[Skill directory: {skill_dir}] — resolve any RELATIVE paths in this "
                            f"skill (scripts/…, references/…, templates/…) against that directory and "
                            f"run/read them with the terminal/read_file tools using the ABSOLUTE path.\n\n"
                            + body)
                except Exception as e:
                    return f"Error reading skill '{skill_name}': {e}"
    names = ", ".join(n for n, _ in scan_skills_index())
    return f"Error: skill '{skill_name}' not found. Available skills: {names}"

_SKILL_TOOL = {"type": "function", "function": {
    "name": "use_skill",
    "description": "Load the full step-by-step playbook for a named ChillsPwn skill from the "
                   "AVAILABLE SKILLS list (HTB privesc chains, the AI council, GPU hashcat cracking, "
                   "recon pipeline, report generation, etc.). Call this the moment a skill matches "
                   "your objective, then FOLLOW its instructions using your tools.",
    "parameters": {"type": "object", "properties": {
        "skill": {"type": "string", "description": "exact skill name from the AVAILABLE SKILLS list"}},
        "required": ["skill"]}}}
def _slugify_skill(name):
    return re.sub(r"[^a-z0-9]+", "-", (name or "").strip().lower()).strip("-")[:64]

def skill_manage(action, name, description, content, mode="append"):
    """Create a NEW reusable skill or PATCH an existing one (Hermes-style self-improving skills).
    Writes SKILL.md into the CURATED plugin skills dir so it's indexed next session AND shared
    with the Claude path. Returns a status string."""
    slug = _slugify_skill(name)
    if not slug:
        return "Error: a valid skill name (kebab-case) is required."
    sdir = os.path.join(SKILLS_DIRS[0], slug)
    md = os.path.join(sdir, "SKILL.md")
    act = (action or "").strip().lower()
    try:
        if act in ("save", "create", "new"):
            if not (content or "").strip():
                return "Error: 'content' (the SKILL.md body) is required to save a skill."
            if os.path.exists(md):
                return f"Error: skill '{slug}' already exists — use action='patch' to update it."
            os.makedirs(sdir, exist_ok=True)
            desc = (description or "").strip() or f"Reusable workflow: {name}"
            with open(md, "w", encoding="utf-8") as f:
                f.write(f"---\nname: {slug}\ndescription: {desc}\n---\n\n" + content.strip() + "\n")
            return (f"✓ Saved skill '{slug}' → {md}. Loadable now via use_skill('{slug}'); it appears "
                    f"in AVAILABLE SKILLS next session and is shared with the Claude path.")
        if act == "patch":
            if not os.path.exists(md):
                return f"Error: skill '{slug}' not found — use action='save' to create it first."
            with open(md, encoding="utf-8") as f:
                existing = f.read()
            if (mode or "append").lower() == "replace":
                m = re.match(r"(?s)^(---\n.*?\n---\n)(.*)$", existing)
                head = m.group(1) if m else ""
                new = head + "\n" + (content or "").strip() + "\n"
            else:
                new = existing.rstrip() + "\n\n" + (content or "").strip() + "\n"
            with open(md, "w", encoding="utf-8") as f:
                f.write(new)
            return f"✓ Patched skill '{slug}' ({mode}). Reload with use_skill('{slug}')."
        return "Error: action must be 'save' (create) or 'patch'."
    except Exception as e:
        return f"Error in skill_manage: {e}"

_SKILL_MANAGE_TOOL = {"type": "function", "function": {
    "name": "skill_manage",
    "description": "Create a NEW reusable skill or PATCH an existing one — capture a working "
                   "attack chain / workflow so you and future sessions reuse it instead of "
                   "re-deriving it (Hermes-style self-improving skills). action='save' needs "
                   "name+description+content; action='patch' needs name+content (mode='append' "
                   "default, or 'replace' to rewrite the body). Do this whenever you complete a "
                   "non-trivial repeatable procedure, or find a loaded skill outdated/wrong.",
    "parameters": {"type": "object", "properties": {
        "action": {"type": "string", "enum": ["save", "patch"]},
        "name": {"type": "string", "description": "skill name in kebab-case"},
        "description": {"type": "string", "description": "one-line description for the index (required on save)"},
        "content": {"type": "string", "description": "the SKILL.md body — the step-by-step workflow in markdown"},
        "mode": {"type": "string", "enum": ["append", "replace"], "description": "patch mode (default append)"}},
        "required": ["action", "name", "content"]}}}

_SKILLS_INDEX = scan_skills_index()
if _SKILLS_INDEX:
    _OPENAI_TOOLS = list(_OPENAI_TOOLS) + [_SKILL_TOOL, _SKILL_MANAGE_TOOL]
    _TOOL_NAMES = set(_TOOL_NAMES) | {"use_skill", "skill_manage"}


# ── Immediate in-session memory write (operator-requested). `remember` lets the model persist a
# DURABLE learning to GLOBAL memory MID-engagement (not waiting for the Level-1 cron QA), through the
# SAME gated, additive-only CLI the reviewer uses (chillspwn_mem.py: backup-before-write, audit log,
# pin-protected, soft-delete). Deduped against the current memory snapshot so it cannot bloat the KB.
def _remember(text, target, sid, mem_now):
    text = re.sub(r"\s+", " ", (text or "").strip())
    if len(text) < 8:
        return json.dumps({"error": "nothing to remember (text too short / empty)"})
    target = target if target in ("memory", "user") else "memory"
    if text.lower()[:140] in re.sub(r"\s+", " ", (mem_now or "").lower()):
        return json.dumps({"ok": True, "skipped": "already in memory", "text": text[:80]})
    import subprocess
    try:
        r = subprocess.run([sys.executable, os.path.join(_SC_DIR, "chillspwn_mem.py"),
                            "add", "--target", target, "--text", text, "--actor", f"or-session:{sid}"],
                           capture_output=True, text=True, timeout=30)
        return json.dumps({"ok": r.returncode == 0, "target": target, "saved": text[:100],
                           "detail": (r.stdout or r.stderr or "").strip()[:160]})
    except Exception as e:
        return json.dumps({"error": f"remember failed: {type(e).__name__}: {e}"})


_REMEMBER_TOOL = {"type": "function", "function": {
    "name": "remember",
    "description": "Immediately persist a DURABLE, reusable learning to GLOBAL memory — shared across ALL "
                   "future sessions and read back by recall_conversation. Call it the MOMENT you confirm "
                   "something worth keeping for next time: a validated credential, a working exploit / "
                   "technique / command, a confirmed vulnerability, a key environment fact, or a user "
                   "preference or correction (use target='user' for those). Do NOT save transient state or "
                   "raw command spam — the per-session engagement ledger already records every command+result; "
                   "this is ONLY for distilled, lasting knowledge. For a repeatable multi-step PROCEDURE, "
                   "prefer skill_manage(action='save'). Writes go through the gated additive memory store and "
                   "are deduplicated automatically.",
    "parameters": {"type": "object", "properties": {
        "text": {"type": "string", "description": "the durable fact to remember, as ONE concise sentence"},
        "target": {"type": "string", "enum": ["memory", "user"],
                   "description": "memory = an ops / engagement / environment fact (default); user = a fact or preference about the operator"}},
        "required": ["text"]}}}
_OPENAI_TOOLS = list(_OPENAI_TOOLS) + [_REMEMBER_TOOL]
_TOOL_NAMES = set(_TOOL_NAMES) | {"remember"}


# ── Automatic in-session memory promotion. Because the model does not reliably call `remember` on
# its own, the orchestrator ALSO auto-promotes high-value DURABLE findings from the ledger into GLOBAL
# memory the moment they're recorded — gated (chillspwn_mem add → backup/audit), deduped (per-session
# set + current-memory snapshot), category-filtered, and fully disablable. CHILLSPWN_OR_AUTO_MEMORY=0
# turns it off entirely; CHILLSPWN_OR_AUTO_MEMORY_CATS picks which of the 4 categories promote.
_AUTO_PROMOTE = (os.environ.get("CHILLSPWN_OR_AUTO_MEMORY") or "1").strip().lower() not in ("0", "false", "no", "off")
_PROMOTE_CATS = {c.strip() for c in (os.environ.get("CHILLSPWN_OR_AUTO_MEMORY_CATS")
                 or "credentials,vulns,flags,key_facts").split(",") if c.strip()}


def _durable_facts(ledger):
    """(key, fact) pairs for the high-value durable ledger items eligible for global-memory promotion."""
    out = []
    if "credentials" in _PROMOTE_CATS:
        for c in (ledger.get("credentials") or []):
            if isinstance(c, dict) and c.get("validated") and c.get("secret"):
                out.append((f"cred:{c.get('user')}:{c.get('secret')}:{c.get('service')}",
                            f"Validated credential {c.get('user','')}:{c.get('secret','')} @ "
                            f"{c.get('service','') or '?'}" + (f" (source: {c.get('source','')})" if c.get('source') else "")))
    if "vulns" in _PROMOTE_CATS:
        for v in (ledger.get("vulns") or []):
            if isinstance(v, dict) and v.get("exploited") and v.get("name"):
                out.append((f"vuln:{v.get('host')}:{v.get('name')}",
                            f"Exploitable: {v.get('name','')} on {v.get('host','') or '?'}"
                            + (f" — {v.get('detail','')}" if v.get('detail') else "")))
    if "flags" in _PROMOTE_CATS:
        for f in (ledger.get("flags") or []):
            # only promote a flag whose value is actually flag-shaped — a window id / pid / file
            # size / exit code / placeholder word must NEVER reach global memory as a "captured flag".
            if isinstance(f, dict) and _flag_is_real(f.get("value")):
                out.append((f"flag:{f.get('value')}",
                            f"Flag ({f.get('type','') or '?'}) {f.get('value','')} @ {f.get('host','') or '?'}"))
    if "key_facts" in _PROMOTE_CATS:
        for kf in (ledger.get("key_facts") or []):
            if isinstance(kf, str) and len(kf.strip()) >= 8:
                out.append((f"kf:{kf.strip().lower()[:80]}", kf.strip()))
    return out


def _promote_durable_to_memory(ledger, promoted, mem_now, sid):
    """Auto-promote NEW durable findings from the ledger to GLOBAL memory (the reliable half of
    'immediate in-session memory writes'). Deduped via the per-session `promoted` set AND `_remember`'s
    own check against the current memory. Returns the facts actually written (for a dashboard note)."""
    if not _AUTO_PROMOTE:
        return []
    done = []
    for key, fact in _durable_facts(ledger):
        if key in promoted:
            continue
        promoted.add(key)
        try:
            res = json.loads(_remember(fact, "memory", sid, mem_now))
            if res.get("ok") and not res.get("skipped"):
                done.append(fact)
        except Exception as e:
            sys.stderr.write(f"[orchestrator] promote failed: {e}\n")
    return done

# ── Sub-agent delegation (#57). delegate_task spawns a CHILD orchestrator to run a focused
# sub-task in an ISOLATED context with its own budget, then returns the result to the parent —
# mirroring Hermes' delegate_task. Bounded: registered ONLY at the top level (depth 0) so a
# sub-agent can't recursively spawn more sub-agents. An optional tool whitelist restricts the
# child's tools. The completion sentinel is module-level so the child + parent agree on it.
DONE_SENTINEL = "<<OBJECTIVE_COMPLETE>>"
try:
    _SUBAGENT_DEPTH = int((os.environ.get("CHILLSPWN_OR_SUBAGENT_DEPTH") or "0").strip() or "0")
except (TypeError, ValueError):
    _SUBAGENT_DEPTH = 0
_DELEGATE_TOOL = {"type": "function", "function": {
    "name": "delegate_task",
    "description": "Delegate a focused SUB-TASK to a fresh sub-agent that runs autonomously in an "
                   "ISOLATED context with its own tool loop + budget, then returns its findings. "
                   "Use it to decompose a big objective (e.g. 'fully enumerate the web app and "
                   "report creds/endpoints' as a self-contained unit) or to run an investigation "
                   "without cluttering your own context. The sub-agent has the same tools/skills "
                   "and CANNOT ask the user — give it everything it needs in the task.",
    "parameters": {"type": "object", "properties": {
        "task": {"type": "string", "description": "the complete, self-contained sub-task incl. all context the sub-agent needs"},
        "tools": {"type": "array", "items": {"type": "string"}, "description": "optional tool whitelist for the sub-agent (e.g. ['terminal','read_file','use_skill']); omit for all tools"},
        "max_iters": {"type": "integer", "description": "optional sub-agent iteration budget (default 40)"}},
        "required": ["task"]}}}

# ── Agent-board tools (Phase 1): delegate to OTHER agents by creating kanban cards, run them in
# PARALLEL, and gather their results. Registered ONLY at depth 0 (a board agent can't create board
# cards → bounded process tree). They talk to the dashboard over localhost HTTP, so all kanban DB
# writes funnel through the dashboard's single-threaded writer (no SQLITE_BUSY race).
_DASHBOARD_URL = os.environ.get("CHILLSPWN_DASHBOARD_URL", "http://127.0.0.1:3131")
_BOARD_CREATE_TOOL = {"type": "function", "function": {
    "name": "board_create_task",
    "description": "Delegate a task to ANOTHER agent by creating a card on the kanban board. The named agent "
                   "(a persona column) spawns in its OWN context with its own tools and runs the task "
                   "autonomously; its tools + result are tracked on the card. Returns a card_id. Fan OUT work to "
                   "specialist agents in PARALLEL by creating several cards, then board_await their ids to gather "
                   "the results. Call board_list first to see which agent columns exist.",
    "parameters": {"type": "object", "properties": {
        "agent": {"type": "string", "description": "the agent / column name (a persona) to run the task; use \"__plan__\" to add the card to your own Backlog/Plan as a visible plan step that does NOT auto-run (then promote it later with board_update). Do NOT create a fresh plan card for an engagement you already have a Backlog plan for — board_update the existing one (mark steps done / promote) instead of stacking duplicates; older same-persona plans are auto-archived when you start a new one."},
        "title": {"type": "string", "description": "short task title"},
        "body": {"type": "string", "description": "the full self-contained task instructions (the agent cannot ask you back)"},
        "engagement": {"type": "string", "description": "optional engagement name → agent runs in that dir + shares its memory"}},
        "required": ["agent", "title", "body"]}}}
_BOARD_AWAIT_TOOL = {"type": "function", "function": {
    "name": "board_await",
    "description": "Block until the given board cards finish (done/failed) and return each card's result + the "
                   "tools it used. This GATHERS a parallel fan-out: create cards with board_create_task, collect "
                   "their ids, then board_await(ids) to get all results back for analysis + next-wave planning. "
                   "Always returns by the timeout (stragglers come back with status 'timeout').",
    "parameters": {"type": "object", "properties": {
        "card_ids": {"type": "array", "items": {"type": "string"}, "description": "card ids returned by board_create_task"},
        "timeout": {"type": "integer", "description": "max seconds to wait (default 600, hard cap 900)"}},
        "required": ["card_ids"]}}}
_BOARD_LIST_TOOL = {"type": "function", "function": {
    "name": "board_list",
    "description": "List the board's agent columns and current cards (id, agent, status, title) so you can plan: "
                   "which specialist agents are available to delegate to, and what is already in flight.",
    "parameters": {"type": "object", "properties": {}}}}
_BOARD_UPDATE_TOOL = {"type": "function", "function": {
    "name": "board_update",
    "description": "Update a board card to keep your plan HONEST and current. The MOMENT a plan/Backlog step's "
                   "work is finished, mark it done (status='done') — NEVER leave completed work sitting in "
                   "Backlog; a stale board misleads you and the operator. As you execute a multi-step plan, "
                   "board_update each step to done as you clear it. To actually RUN a planned step, PROMOTE its "
                   "card to a specialist agent (assignee='<persona>') instead of leaving it inert in Backlog.",
    "parameters": {"type": "object", "properties": {
        "card_id": {"type": "string", "description": "the card to update"},
        "status": {"type": "string", "description": "e.g. done | queued | backlog"},
        "assignee": {"type": "string", "description": "promote the card to this agent column (queues it to run)"}},
        "required": ["card_id"]}}}
if _SUBAGENT_DEPTH == 0:
    _OPENAI_TOOLS = list(_OPENAI_TOOLS) + [_DELEGATE_TOOL, _BOARD_CREATE_TOOL, _BOARD_AWAIT_TOOL, _BOARD_LIST_TOOL, _BOARD_UPDATE_TOOL]
    _TOOL_NAMES = set(_TOOL_NAMES) | {"delegate_task", "board_create_task", "board_await", "board_list", "board_update"}


def _board_http(method, path, body=None, timeout=15):
    data = json.dumps(body).encode() if body is not None else None
    req = Request(_DASHBOARD_URL + path, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urlopen(req, timeout=timeout) as r:
            raw = r.read().decode("utf-8", "replace")
            return json.loads(raw) if raw.strip() else {}
    except Exception as e:
        return {"error": f"{type(e).__name__}: {e}"}


# When a fresh self-plan is created, retire the SAME persona's OLDER orchestrator Backlog plans
# (status -> archived) so cross-session re-planning doesn't pile up duplicate plan cards. Touches
# ONLY that persona's own orchestrator-created Backlog cards older than the TTL — never agent cards,
# human cards, dispatched/done cards, or recent same-session plan steps. Tunable via env.
_PLAN_SUPERSEDE_TTL = int(os.environ.get("CHILLSPWN_OR_PLAN_TTL_SEC", "1200"))  # default 20 min
def _supersede_stale_plans(assignee, keep_id):
    try:
        cards = (_board_http("GET", "/api/board") or {}).get("cards") or []
        now_ms = time.time() * 1000.0
        n = 0
        for c in cards:
            if (c.get("id") != keep_id
                    and str(c.get("assignee")) == str(assignee)
                    and c.get("createdBy") == "orchestrator"
                    and c.get("status") == "backlog"):
                created_ms = c.get("createdAt") or 0          # /api/board returns ms
                if created_ms and (now_ms - created_ms) > _PLAN_SUPERSEDE_TTL * 1000:
                    _board_http("PUT", f"/api/board/card/{c.get('id')}", {"status": "archived"})
                    n += 1
        return n
    except Exception:
        return 0


def board_create_task(agent, title, body, engagement=None, self_model=None):
    if not agent or not title:
        return json.dumps({"error": "board_create_task needs agent + title"})
    self_persona = os.environ.get("CHILLSPWN_OR_PERSONA", "")
    # SELF-PLANNING: agent "self"/"__plan__"/"backlog"/"plan" (or your own persona name) → the card goes
    # to YOUR OWN Backlog/Plan column and shows YOUR current model. DELEGATING to a DIFFERENT agent → that
    # agent runs on its OWN provider config; do NOT attach yours.
    is_self = agent in ("self", "__plan__", "backlog", "plan") or (bool(self_persona) and agent == self_persona)
    if is_self and self_persona:
        agent = self_persona
    payload = {"title": title, "body": body or "", "assignee": agent,
               "engagement": engagement or "", "createdBy": "orchestrator"}
    if is_self and self_model:
        # Stamp the card with the orchestrator's ACTUAL backend so it dispatches + displays
        # correctly. PROVIDER.name is "codex" for the Codex backend; the server/persona canonical
        # string is "openai-codex" — map it. (Was hardcoded "openrouter", which mislabeled every
        # Codex self-card as OpenRouter and routed it down the wrong dispatch path.)
        payload["provider"] = "openai-codex" if PROVIDER.name == "codex" else "openrouter"
        payload["model"] = self_model         # the plan card shows the model YOU are planning with
    r = _board_http("POST", "/api/kanban", payload)
    if r.get("error"):
        return json.dumps({"error": r["error"]})
    new_id = r.get("id")
    # Auto-archive this persona's older stale plan cards so the Backlog reflects the CURRENT plan.
    superseded = _supersede_stale_plans(agent, new_id) if (is_self and new_id) else 0
    return json.dumps({"ok": True, "card_id": new_id, "agent": agent,
                       "dispatched": r.get("dispatched"), "superseded_stale_plans": superseded})


def board_await(card_ids, timeout=600):
    if isinstance(card_ids, str):
        card_ids = [c.strip() for c in card_ids.split(",") if c.strip()]
    if not card_ids:
        return json.dumps({"error": "board_await needs card_ids"})
    timeout = min(int(timeout or 600), 900)
    deadline = time.time() + timeout
    results = {}
    while time.time() < deadline and len(results) < len(card_ids):
        for cid in card_ids:
            if cid in results:
                continue
            c = _board_http("GET", f"/api/kanban/card/{cid}")
            if c.get("error"):
                continue
            if c.get("status") in ("done", "failed"):
                results[cid] = {"status": c.get("status"),
                                "result": str(c.get("result") or c.get("error") or "")[:6000],
                                "tools": [t.get("name") for t in (c.get("tools") or []) if isinstance(t, dict)]}
        if len(results) < len(card_ids):
            time.sleep(2)
    for cid in card_ids:
        results.setdefault(cid, {"status": "timeout", "result": "(still running when board_await timed out)", "tools": []})
    return json.dumps({"ok": True, "results": results})


def board_list():
    cards = (_board_http("GET", "/api/board") or {}).get("cards") or []
    cols = (_board_http("GET", "/api/board/columns") or {}).get("columns") or []
    return json.dumps({
        "agents": [c.get("persona") for c in cols if not c.get("isBacklog") and c.get("enabled")],
        "cards": [{"id": c.get("id"), "agent": c.get("assignee"), "status": c.get("status"), "title": c.get("title")} for c in cards[:40]],
    })


def board_update(card_id, status=None, assignee=None):
    if not card_id:
        return json.dumps({"error": "board_update needs card_id"})
    body = {}
    if status:
        body["status"] = status
    if assignee:
        body["assignee"] = assignee
    return json.dumps(_board_http("PUT", f"/api/board/card/{card_id}", body))
# Optional tool whitelist for a delegated sub-agent (set by the parent's delegate_task env).
_TOOL_WHITELIST = (os.environ.get("CHILLSPWN_OR_TOOL_WHITELIST") or "").strip()
if _TOOL_WHITELIST:
    _allow = {x.strip() for x in _TOOL_WHITELIST.split(",") if x.strip()} | {"use_skill", "recall_conversation"}
    _OPENAI_TOOLS = [t for t in _OPENAI_TOOLS if ((t.get("function") or {}).get("name")) in _allow]
    _TOOL_NAMES = {n for n in _TOOL_NAMES if n in _allow}


# ── Engagement mode: Guided (coaching) vs Autonomous (default). The operator picks once via the
# session-start <user-question>; that pick lives in the FULL session history (it may be distilled
# out of the in-context window), so read it from the session file. AUTONOMOUS is the HARD DEFAULT —
# we never guess Guided, because Guided disables the execution tools and a misdetection would break
# an autonomous run.
_GUIDED_EXEC_BLOCK = {"terminal", "execute_code", "process", "patch", "write_file"}

def _detect_engagement_mode(session_file: str) -> str:
    try:
        with open(session_file) as f:
            msgs = json.load(f).get("messages", [])
    except Exception:
        return "autonomous"
    mode = "autonomous"
    for m in msgs:
        if not isinstance(m, dict) or m.get("role") != "user":
            continue
        c = m.get("content")
        c = c if isinstance(c, str) else json.dumps(c)
        cl = c.lower()
        if "guided mode" in cl or "🎓" in c:
            mode = "guided"
        elif "autonomous mode" in cl or "🚀" in c:
            mode = "autonomous"
    return mode


def emit(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def emit_status(text: str) -> None:
    """Lightweight live-activity label for the dashboard's 'Processing…' indicator. Token-neutral:
    it carries no new model output, just a short description of what the engine is doing right now
    (a phase like distilling/compacting, or a trimmed version of the model's OWN narration)."""
    t = re.sub(r"\s+", " ", (text or "").strip())
    if t:
        emit({"type": "status", "text": t[:120]})


def _emit_activity(narration: str) -> None:
    """Reuse the model's existing pre-tool narration as the activity label (no extra tokens) —
    e.g. 'Trying RBCD via S4U2self…' instead of a flat 'Processing'. Strips control sentinels and
    markdown noise, takes the first meaningful sentence/line."""
    s = (narration or "").replace(DONE_SENTINEL, "")
    line = next((ln.strip(" #*->`") for ln in s.splitlines() if ln.strip(" #*->`")), "")
    if line:
        # first sentence if it's long, else the whole line
        m = re.match(r"(.{12,90}?[.!:])(\s|$)", line)
        emit_status(m.group(1) if m else line)


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--model", required=True)
    p.add_argument("--prompt", required=True)
    p.add_argument("--system-file", required=True)
    p.add_argument("--session-file", required=True)
    p.add_argument("--cwd", default=os.getcwd())
    p.add_argument("--provider", default="openrouter",
                   help="openrouter (default) | openai-codex — selects the Provider class")
    return p.parse_args()


# ───────────────────────── HTTP ─────────────────────────

def http_post(url, headers, body):
    req = Request(url, data=json.dumps(body).encode("utf-8"), headers=headers, method="POST")
    try:
        with urlopen(req, timeout=HTTP_TIMEOUT) as r:
            return json.loads(r.read().decode("utf-8"))
    except HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")[:600]
        raise RuntimeError(f"OpenRouter HTTP {e.code}: {detail}")


def stream_post(url, headers, body, on_text):
    """Stream a chat completion over SSE. Calls on_text(chunk) for each text delta as it
    arrives, assembles the full message + tool_calls, and returns a response dict in the SAME
    shape as http_post (choices[0].message{content,tool_calls}, finish_reason, usage, model)
    so the caller's loop logic is identical to the non-streaming path."""
    sbody = dict(body)
    sbody["stream"] = True
    sbody["stream_options"] = {"include_usage": True}   # so usage arrives in the final chunk
    req = Request(url, data=json.dumps(sbody).encode("utf-8"), headers=headers, method="POST")
    full_text, tcs = [], {}
    finish_reason = model = usage = None
    try:
        with urlopen(req, timeout=HTTP_TIMEOUT) as r:
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line or not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    chunk = json.loads(payload)
                except Exception:
                    continue
                if chunk.get("model"):
                    model = chunk["model"]
                if chunk.get("usage"):
                    usage = chunk["usage"]
                ch = (chunk.get("choices") or [{}])[0]
                if ch.get("finish_reason"):
                    finish_reason = ch["finish_reason"]
                delta = ch.get("delta") or {}
                if delta.get("content"):
                    full_text.append(delta["content"])
                    on_text(delta["content"])
                for tc in (delta.get("tool_calls") or []):
                    idx = tc.get("index", 0)
                    slot = tcs.setdefault(idx, {"id": None, "name": None, "args": []})
                    if tc.get("id"):
                        slot["id"] = tc["id"]
                    fn = tc.get("function") or {}
                    if fn.get("name"):
                        slot["name"] = fn["name"]
                    if fn.get("arguments"):
                        slot["args"].append(fn["arguments"])
    except HTTPError as e:
        detail = e.read().decode("utf-8", errors="replace")[:600]
        raise RuntimeError(f"OpenRouter HTTP {e.code}: {detail}")
    assembled = []
    for idx in sorted(tcs):
        s = tcs[idx]
        assembled.append({"id": s["id"] or f"call_{idx}", "type": "function",
                          "function": {"name": s["name"] or "", "arguments": "".join(s["args"])}})
    msg = {"content": "".join(full_text)}
    if assembled:
        msg["tool_calls"] = assembled
    return {"choices": [{"message": msg, "finish_reason": finish_reason}],
            "usage": usage or {}, "model": model}


def get_context_window(model, headers):
    env = os.environ.get("CHILLSPWN_OR_CONTEXT_WINDOW")
    if env:
        try:
            return max(8000, int(env))
        except ValueError:
            pass
    # Provider-declared window — codex has no /models endpoint to query, so it carries its
    # real window as an attribute. OpenRouter leaves this unset and falls through to the
    # per-model /models lookup below. Prevents codex defaulting to the 128k DEFAULT_WINDOW.
    pw = getattr(PROVIDER, "context_window", None)
    if pw:
        try:
            return max(8000, int(pw))
        except (ValueError, TypeError):
            pass
    try:
        req = Request(PROVIDER.models_url, headers={"Authorization": headers["Authorization"]}, method="GET")
        with urlopen(req, timeout=15) as r:
            data = json.loads(r.read().decode("utf-8"))
        for m in data.get("data", []):
            if m.get("id") == model:
                cl = m.get("context_length") or (m.get("top_provider") or {}).get("context_length")
                if cl:
                    return int(cl)
    except Exception:
        pass
    return DEFAULT_WINDOW


# ───────────────────────── tokens ─────────────────────────

_ENC = None
def _encoder():
    global _ENC
    if _ENC is None:
        try:
            import tiktoken
            _ENC = tiktoken.get_encoding("cl100k_base")
        except Exception:
            _ENC = False
    return _ENC

def estimate_tokens(messages) -> int:
    enc = _encoder()
    total = 0
    for m in messages:
        c = m.get("content")
        s = c if isinstance(c, str) else json.dumps(c)
        if m.get("tool_calls"):
            s += json.dumps(m["tool_calls"])
        if enc:
            try:
                total += len(enc.encode(s)) + 4
                continue
            except Exception:
                pass
        total += len(s) // 4 + 4
    return total


# ───────────────────────── ledger ─────────────────────────

def empty_ledger():
    return {"hosts": {}, "credentials": [], "vulns": [], "flags": [],
            "tasks_done": [], "tasks_pending": [], "key_facts": [], "actions": [],
            "_distilled_upto": 0}

def ledger_path(session_file: str) -> str:
    return session_file + ".ledger.json"

def load_ledger(session_file: str) -> dict:
    try:
        with open(ledger_path(session_file)) as f:
            d = json.load(f)
        for k in LEDGER_KEYS:
            d.setdefault(k, [] if k != "hosts" else {})
        d.setdefault("_distilled_upto", 0)
        return _curate_ledger(sanitize_flags(d))   # self-heal: scrub non-flag values + de-noise key_facts/tasks every load
    except Exception:
        return empty_ledger()

def save_ledger(session_file: str, ledger: dict) -> None:
    try:
        tmp = ledger_path(session_file) + ".tmp"
        with open(tmp, "w") as f:
            json.dump(ledger, f)
        os.replace(tmp, ledger_path(session_file))
    except Exception as e:
        sys.stderr.write(f"[orchestrator] ledger save failed: {e}\n")

def _render_ledger_body(ledger: dict) -> list:
    """The structured-state lines ONLY (no planning preamble) — shared by render_ledger (which
    prepends the preamble for messages[1]) and recall (which searches the state without it)."""
    out = []
    hosts = ledger.get("hosts") or {}
    if hosts:
        out.append("### Hosts")
        for ip, h in hosts.items():
            bits = []
            if h.get("hostname"): bits.append(h["hostname"])
            if h.get("os"): bits.append(h["os"])
            ports = ", ".join(h.get("ports") or [])
            line = f"- {ip}" + (f" ({'; '.join(bits)})" if bits else "")
            if ports: line += f" — ports: {ports}"
            if h.get("notes"): line += f" — {h['notes']}"
            out.append(line)
    creds = ledger.get("credentials") or []
    if creds:
        out.append("### Credentials")
        for c in creds:
            v = "✓valid" if c.get("validated") else "?untested"
            out.append(f"- {c.get('user','')}:{c.get('secret','')} @ {c.get('service','')} [{v}] {c.get('source','')}".rstrip())
    vulns = ledger.get("vulns") or []
    if vulns:
        out.append("### Vulnerabilities")
        for v in vulns:
            x = "EXPLOITED" if v.get("exploited") else "found"
            out.append(f"- [{x}] {v.get('host','')}: {v.get('name','')} — {v.get('detail','')}".rstrip())
    flags = ledger.get("flags") or []
    if flags:
        out.append("### Flags captured (verified — real flag values only)")
        for f in flags:
            out.append(f"- {f.get('type','')}: {f.get('value','')} @ {f.get('host','')}".rstrip())
    def _cap(items, n):
        """Most-recent n items + a note string if older entries were dropped (kept on disk
        for recall_conversation). Returns (shown_list, note)."""
        if n <= 0 or len(items) <= n:
            return items, ""
        return items[-n:], f"  [showing last {n} of {len(items)} — older via recall_conversation]"
    acts = ledger.get("actions") or []
    if acts:
        shown, note = _cap(acts, LEDGER_CAP_ACTIONS)
        out.append("### Commands already run — command → result  (LEARN from these: never repeat an IDENTICAL "
                   "command expecting the same result; if a result was a failure/partial, RETRY only with a "
                   "BETTER method — different flags / tool / wordlist / credential — never re-loop the dead end)" + note)
        for ac in shown:
            if not isinstance(ac, dict):
                continue
            oc = ac.get("outcome") or "?"
            tool = ac.get("tool") or ""
            cmd = ac.get("command") or ""
            res = ac.get("result") or ""
            line = f"- [{oc}]" + (f" ({tool})" if tool else "") + f" `{cmd}`"
            if res:
                line += f" → {res}"
            out.append(line[:600])
    done = ledger.get("tasks_done") or []
    if done:
        shown, note = _cap(done, LEDGER_CAP_TASKS_DONE)
        out.append("### Tasks already done (do NOT repeat)" + note)
        out += [f"- {t}" for t in shown]
    pend = ledger.get("tasks_pending") or []
    if pend:
        shown, note = _cap(pend, LEDGER_CAP_TASKS_PEND)
        out.append("### Open threads / next steps" + note)
        out += [f"- {t}" for t in shown]
    kf = ledger.get("key_facts") or []
    if kf:
        shown, note = _cap(kf, LEDGER_CAP_KEY_FACTS)
        out.append("### Key facts" + note)
        out += [f"- {t}" for t in shown]
    return out


def render_ledger(ledger: dict) -> str:
    """Structured state + the planning preamble that rides in messages[1] each turn (never compacted)."""
    head = [
        "## CURRENT ENGAGEMENT STATE  (auto-maintained from this engagement's history — established context; it MAY be from an EARLIER session/spawn, so confirm the live target before acting on it)",
        "PLAN PROGRESSIVELY — before your next tool call: read this state, your PERSISTENT MEMORY, and the "
        "ARTIFACTS you have written in the project / engagement directory (notes, scan outputs, loot files), "
        "then take the SINGLE next step that moves the OBJECTIVE forward from where this leaves off. Do NOT "
        "re-run work already recorded here. Do NOT wander into unrelated tests. Do NOT loop a failing command — "
        "if a result was a failure or only partial, change the approach (different flags / tool / wordlist / "
        "credential / path) or move to the next lead. Use recall_conversation for any specifics not shown here.",
        "CONFIRM THE LIVE TARGET — the state above may be from an earlier session/spawn. Before any state-changing "
        "or intrusive action (recon, exploit, editing /etc/hosts, using stored credentials) against a host recorded "
        "here, make sure the operator's CURRENT request actually names or authorizes that target. If you are RESUMING "
        "and the operator has NOT confirmed the live/spawned target IP in this turn, ask ONE concise question (emit a "
        "<user-question> block) to confirm BEFORE acting on recalled state — do not assume the previously-recorded box "
        "is the one they want now.",
        "FLAG HONESTY — NEVER claim a flag is captured or a box is owned/rooted unless you can show the ACTUAL "
        "flag value AND it is flag-shaped: 32/40/64 hex chars, or NAME{...}. A window id, PID, file size, exit "
        "code, or a word like 'captured' is NOT a flag. If you have not read the real flag yet, the box is NOT "
        "done — say so plainly and keep working; do not report a placeholder as the flag.",
        "DEAD-END PIVOT — if every remote-exec method (atexec/wmiexec/dcomexec/smbexec, named-pipe spoolss, "
        "winexe) returns access_denied or the named pipe is blocked, STOP retrying that family and STOP fighting "
        "GUI/RDP keystroke injection (xdotool/XTest into a windowless Xvfb is a known dead end here). Pivot to an "
        "ACL/identity path instead: RBCD or S4U2self with a controlled machine account, a scheduled/triggered "
        "task dropped into a writable directory, password-reset of a privileged principal you have rights over, "
        "or DCSync once you hold the replication rights. Re-running the same blocked transport is not progress.",
        "USE YOUR SKILLS + ADAPT — you have purpose-built skills and tools (see the AVAILABLE SKILLS list: HTB/AD "
        "privesc chains, recon-osint, web-security, the cve-researcher / Researcher board agent, GPU hashcat "
        "cracking, the AI council, etc.). For any task with a matching skill, LOAD IT with use_skill and follow "
        "its playbook FIRST instead of improvising from raw terminal — that is what they are for. BUT a skill is a "
        "means, not a guarantee: if a skill, tool, or technique produces NO meaningful result after one or two "
        "honest attempts (errors, empty output, no new access/finding), ABANDON it and switch to a DIFFERENT "
        "skill / tool / technique or attack surface. Never burn turns re-loading or re-running a skill/tool that "
        "is not advancing the objective — adapt to an alternative approach, and if you exhaust your alternatives "
        "say so and consider use_skill('council-of-ais') for fresh attack vectors.",
        "NARRATE AS YOU WORK — Mr. Wong wants to FOLLOW ALONG, not watch silent command spam. In the SAME turn "
        "as your action: your FIRST line MUST be a SHORT present-tense status naming the SPECIFIC action + "
        "target (≤8 words — e.g. 'Kerberoasting svc_sql', 'Reading /etc/passwd', 'Cracking the gMSA NTLM on GPU', "
        "'Port-scanning 10.129.x') — it becomes the live activity label the operator watches; THEN one line of WHY/what you expect; "
        "AFTER the result, ONE line on what it means in plain English + the next move. Teach as you go and keep "
        "him oriented — but narrate WHILE acting, never INSTEAD of acting (don't stop on a mere summary — keep "
        "executing routine next steps; BUT DO pause and ask — emit a <user-question> — at genuine decision points "
        "and ESPECIALLY when an approach has FAILED, which is Mr. Wong's standing preference). Silent back-to-back "
        "tool calls with no explanation are wrong.",
    ]
    body = _render_ledger_body(ledger)
    if not body:
        body = ["(empty — nothing recorded yet; orient from your persistent memory + any project-dir artifacts, then take the first step)"]
    return "\n".join(head + body)


_STOPWORDS = frozenset((
    "the", "and", "for", "with", "that", "this", "you", "your", "from", "are", "was", "were",
    "what", "which", "who", "get", "got", "run", "use", "used", "its", "into", "out", "not",
    "all", "any", "can", "has", "have", "had", "will", "they", "them", "our", "but", "per",
    "find", "show", "tell", "about", "there", "here", "when", "how", "why", "did", "does"))


def _kw_filter(text: str, terms, max_chars: int, fallback_head: bool = True) -> str:
    """Rank the LINES of `text` by query-term hits — a whole-word match scores 2, a >=4-char
    substring match scores 1 — and return the best lines up to max_chars in original order.
    Stopwords are dropped so a term like 'for' can't substring-match 'forward'/'before'. If
    nothing matches (or there are no usable terms) and fallback_head is set, return the HEAD of
    the text instead — so a small curated source (the ledger body / persistent memory) is never
    silently dropped just because the query didn't lexically overlap ('passwords' vs 'passphrase')."""
    text = text or ""
    if max_chars <= 0:
        return ""
    qterms = [t for t in (terms or []) if t and t not in _STOPWORDS]
    if qterms:
        scored = []
        for i, ln in enumerate(text.splitlines()):
            words = set(re.findall(r"[a-z0-9]+", ln.lower()))
            s = 0
            for t in qterms:
                if t in words:
                    s += 2
                elif len(t) >= 4 and any(t in w for w in words):
                    s += 1
            if s > 0:
                scored.append((s, i, ln))
        if scored:
            scored.sort(key=lambda x: (-x[0], x[1]))
            picked, used = [], 0
            for _, i, ln in scored:
                if used + len(ln) + 1 > max_chars:
                    continue
                picked.append((i, ln)); used += len(ln) + 1
            picked.sort(key=lambda x: x[0])
            return "\n".join(ln for _, ln in picked)
    return text[:max_chars] if fallback_head else ""


def _extract_memory_sections(messages) -> str:
    """Pull the persistent-memory regions out of the inlined system prompt (messages[0]).
    The server inlines USER.md + MEMORY.md under '## USER PREFERENCES (MANDATORY)' and
    '## PERSISTENT MEMORY' headers; slice each from its header to the next top-level '## '.
    Reading from messages[0] means recall always reflects exactly what's in context this turn,
    with no file-path/permission dependency."""
    if not messages:
        return ""
    c = messages[0].get("content") if isinstance(messages[0], dict) else ""
    if not isinstance(c, str) or not c:
        return ""
    out = []
    for hdr in ("## USER PREFERENCES (MANDATORY)", "## PERSISTENT MEMORY"):
        idx = c.find(hdr)
        if idx < 0:
            continue
        rest = c[idx:]
        nxt = rest.find("\n## ", len(hdr))
        out.append(rest[:nxt] if nxt > 0 else rest[:8000])
    return "\n\n".join(out)


def _merge_lists(old, new, key=None):
    """Append new items not already present (dedup by key or by value)."""
    out = list(old or [])
    seen = set()
    for it in out:
        seen.add(json.dumps(it.get(key) if (key and isinstance(it, dict)) else it, sort_keys=True))
    for it in (new or []):
        k = json.dumps(it.get(key) if (key and isinstance(it, dict)) else it, sort_keys=True)
        if k not in seen:
            out.append(it); seen.add(k)
    return out


# ── Flag-value validation. A "captured flag" MUST carry a real flag value. The distillation LLM
# once recorded an X11 window id (2097154) and the literal word "captured" as the root/user flag;
# those then rode the ledger as ground truth, got auto-promoted toward memory, and were re-reported
# to the operator as the real flag across context recoveries. Gate every flag so a window id / PID /
# file size / exit code / placeholder word can never masquerade as a captured flag.
_HEX_FLAG = re.compile(r"^(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$")
_BRACED_FLAG = re.compile(r"[A-Za-z0-9_]{2,}\{[^}]{2,}\}")
_BOGUS_FLAG = frozenset((
    "captured", "unknown", "pending", "n/a", "na", "none", "null", "true", "false", "yes", "no",
    "root", "user", "flag", "done", "root.txt", "user.txt", "owned", "rooted", "tbd", "todo"))

def _flag_is_real(value) -> bool:
    """True only if `value` looks like an actual CTF/HTB/VulnLab flag — not a window id, PID,
    file size, exit code, or placeholder word."""
    v = re.sub(r"\s+", "", str(value or "")).strip()
    if not v or v.lower() in _BOGUS_FLAG:
        return False
    if _HEX_FLAG.match(v):            # 32/40/64-hex (HTB / VulnLab / most CTF)
        return True
    if _BRACED_FLAG.search(v):        # NAME{...}  (HTB{}, FLAG{}, picoCTF{}, …)
        return True
    if re.fullmatch(r"\d{1,15}", v):  # pure decimal = window id / PID / size / exit code → NOT a flag
        return False
    return len(v) >= 16               # long opaque token (base64-ish) → plausibly real; short junk → reject

def sanitize_flags(ledger: dict) -> dict:
    """Drop any ledger 'flag' whose value is not flag-shaped, and stamp survivors verified=True.
    Idempotent + self-healing: runs on every load_ledger and after every merge, so a previously
    poisoned ledger cleans itself on the next turn — no manual edit, no race with a live save."""
    flags = ledger.get("flags")
    if not isinstance(flags, list):
        return ledger
    clean = []
    for f in flags:
        if isinstance(f, dict) and _flag_is_real(f.get("value")):
            f["verified"] = True
            clean.append(f)
    if len(clean) != len(flags):
        ledger["flags"] = clean
    return ledger


# ── Ledger curation. The findings-ledger appends key_facts/tasks_done monotonically; over a long
# engagement it accumulates transient noise (process/tunnel PIDs, temp pivots) and formatting-
# duplicate restatements of the same fact (Lens C found ~32 near-dup key_fact buckets + bare-PID
# entries). That junk gets injected every turn (up to the display cap) AND is eligible for auto-
# promotion to GLOBAL memory. Curate conservatively on every load + merge: drop clearly-transient
# entries and collapse entries identical after whitespace/punctuation/case normalization. Distinct
# real facts are kept; nothing is truly lost (the full history stays in the conversation log,
# searchable via recall_conversation). Idempotent + self-healing, like sanitize_flags.
_KF_JUNK = re.compile(
    r"(?i)(\bpid\s*\d{3,}\b|\bproc_[0-9a-f]{6,}\b|listening on 127\.0\.0\.1|"
    r"\btemporary\b[^.]{0,40}\bpivot\b|\bephemeral\b)")

def _curate_ledger(ledger: dict) -> dict:
    kf = ledger.get("key_facts")
    if isinstance(kf, list) and kf:
        seen = set(); clean = []
        for item in kf:
            s = item if isinstance(item, str) else str(item)
            if _KF_JUNK.search(s):
                continue                       # transient process/tunnel noise — drop
            norm = re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()
            if len(norm) < 8 or norm in seen:  # too short / formatting-duplicate
                continue
            seen.add(norm); clean.append(item)
        if len(clean) != len(kf):
            ledger["key_facts"] = clean
    td = ledger.get("tasks_done")              # tasks are real — only collapse formatting-dups
    if isinstance(td, list) and td:
        seen = set(); clean = []
        for item in td:
            s = item if isinstance(item, str) else json.dumps(item, sort_keys=True)
            norm = re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()
            if norm and norm in seen:
                continue
            seen.add(norm); clean.append(item)
        if len(clean) != len(td):
            ledger["tasks_done"] = clean
    return ledger


def merge_ledger(base: dict, incoming: dict) -> dict:
    """Defensive merge of a distillation result into the running ledger."""
    if not isinstance(incoming, dict):
        return base
    # hosts: merge by ip, union ports
    bh = base.get("hosts") or {}
    for ip, h in (incoming.get("hosts") or {}).items():
        if not isinstance(h, dict):
            continue
        cur = bh.get(ip) or {"ports": []}
        cur["ports"] = sorted(set((cur.get("ports") or []) + (h.get("ports") or [])))
        for fld in ("os", "hostname", "notes"):
            if h.get(fld):
                cur[fld] = h[fld]
        bh[ip] = cur
    base["hosts"] = bh
    base["credentials"] = _merge_lists(base.get("credentials"), incoming.get("credentials"), key="user")
    base["vulns"] = _merge_lists(base.get("vulns"), incoming.get("vulns"), key="name")
    base["flags"] = _merge_lists(base.get("flags"), incoming.get("flags"), key="value")
    base["tasks_done"] = _merge_lists(base.get("tasks_done"), incoming.get("tasks_done"))
    base["key_facts"] = _merge_lists(base.get("key_facts"), incoming.get("key_facts"))
    # actions: dedup by the exact command string so a command+result is recorded once.
    base["actions"] = _merge_lists(base.get("actions"), incoming.get("actions"), key="command")
    # pending: replace with incoming if provided (open threads change), else keep
    if incoming.get("tasks_pending"):
        base["tasks_pending"] = incoming["tasks_pending"]
    sanitize_flags(base)   # reject any newly-distilled non-flag value before it becomes ground truth
    _curate_ledger(base)   # drop transient-PID noise + formatting-duplicate key_facts/tasks
    return base


def _brace_slice(txt: str) -> str:
    """Extract the first balanced {...} object by depth counting (ignoring braces inside strings)."""
    start = txt.find("{")
    if start < 0:
        return ""
    depth = 0; in_str = False; esc = False
    for i in range(start, len(txt)):
        ch = txt[i]
        if in_str:
            if esc: esc = False
            elif ch == "\\": esc = True
            elif ch == '"': in_str = False
        else:
            if ch == '"': in_str = True
            elif ch == "{": depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    return txt[start:i + 1]
    return txt[start:]


def _loads_lenient(txt: str):
    """Best-effort parse of model-emitted JSON: direct → brace-matched → naive backslash repair.
    The action-ledger embeds real command OUTPUT (Windows paths like C:\\Users, error strings),
    whose lone backslashes are invalid JSON escapes and routinely break a strict json.loads — so we
    repair `\\x`→`\\\\x` for any backslash that isn't a valid JSON escape, then retry."""
    txt = (txt or "").strip()
    if txt.startswith("```"):
        txt = re.sub(r"^```[a-zA-Z]*\n?", "", txt)
        txt = re.sub(r"\n?```$", "", txt).strip()
    for attempt in (txt, _brace_slice(txt)):
        if not attempt:
            continue
        try:
            return json.loads(attempt)
        except Exception:
            pass
        try:
            repaired = re.sub(r'\\(?!["\\/bfnrt]|u[0-9a-fA-F]{4})', r'\\\\', attempt)
            return json.loads(repaired)
        except Exception:
            pass
    return None


def distill_into_ledger(old_text: str, ledger: dict, model: str, headers: dict) -> dict:
    """One LLM call: extract new structured findings from old turns, merge into ledger."""
    if not old_text.strip():
        return ledger
    skeleton = {k: ledger.get(k) for k in LEDGER_KEYS}
    prompt = (
        "You maintain structured state for a penetration test. From the CONVERSATION "
        "EXCERPT below, extract any NEW concrete facts and return the UPDATED ledger as "
        "STRICT JSON (no prose, no code fence). Keep it factual and de-duplicated.\n\n"
        "Schema: {\"hosts\":{\"<ip>\":{\"ports\":[\"22/ssh\"],\"os\":\"\",\"hostname\":\"\",\"notes\":\"\"}},"
        "\"credentials\":[{\"user\":\"\",\"secret\":\"\",\"service\":\"\",\"source\":\"\",\"validated\":false}],"
        "\"vulns\":[{\"host\":\"\",\"name\":\"\",\"detail\":\"\",\"exploited\":false}],"
        "\"flags\":[{\"type\":\"user|root\",\"value\":\"\",\"host\":\"\"}],"
        "\"tasks_done\":[\"\"],\"tasks_pending\":[\"\"],\"key_facts\":[\"\"],"
        "\"actions\":[{\"tool\":\"terminal|execute_code|...\",\"command\":\"<the EXACT command / tool input that was run>\","
        "\"result\":\"<SHORT single-line JSON-SAFE summary of the concrete real result: the key finding, the "
        "error message, or what was returned — UNDER 180 chars, no raw multi-line dumps, escape or drop any "
        "quotes/backslashes/newlines>\","
        "\"outcome\":\"success|failure|partial\"}]}\n\n"
        "For `actions`: record EVERY meaningful command/tool invocation with its EXACT input and a faithful, "
        "SHORT, JSON-safe summary of its REAL result + an outcome. INCLUDE failures and partial results (they "
        "record what was already tried so it is not blindly repeated, and what to vary next time). This is how "
        "the agent learns from what it ran instead of re-running the same steps — be faithful to the actual "
        "command and result, do not invent. Output STRICT, VALID JSON: every backslash and quote inside a "
        "string value MUST be escaped.\n\n"
        "EXISTING LEDGER:\n" + json.dumps(skeleton) +
        "\n\nCONVERSATION EXCERPT:\n" + old_text[:DISTILL_INPUT_CAP] +
        "\n\nReturn ONLY the updated ledger JSON."
    )
    if PROVIDER.name == "codex":
        # codex uses the Responses API (no chat/completions http_post, no response_format) — the
        # lenient parser below handles the non-JSON-mode output exactly as for any other model.
        try:
            j = PROVIDER.complete(model, [{"role": "user", "content": prompt}], max_tokens=3000, temperature=0)
        except Exception as e:
            sys.stderr.write(f"[orchestrator] codex distill failed (keeping ledger): {e}\n")
            return ledger
    else:
        # force valid JSON on supporting models (deepseek/openai/etc.); models that ignore it
        # still hit the lenient parser below, so this never regresses an unsupported model.
        body = PROVIDER.build_body(model, [{"role": "user", "content": prompt}], max_tokens=3000,
                                   temperature=0, response_format={"type": "json_object"})
        try:
            j = http_post(PROVIDER.chat_url, headers, body)
        except Exception as e:
            # some models/providers reject response_format — retry once without it.
            sys.stderr.write(f"[orchestrator] distill post failed ({e}); retrying without response_format\n")
            body.pop("response_format", None)
            try:
                j = http_post(PROVIDER.chat_url, headers, body)
            except Exception as e2:
                sys.stderr.write(f"[orchestrator] distill failed (keeping ledger): {e2}\n")
                return ledger
    try:
        txt = PROVIDER.parse_choice(j)[0]
        incoming = _loads_lenient(txt)
        if isinstance(incoming, dict):
            return merge_ledger(ledger, incoming)
        sys.stderr.write("[orchestrator] distill: could not parse model JSON (keeping ledger)\n")
    except Exception as e:
        sys.stderr.write(f"[orchestrator] distill failed (keeping ledger): {e}\n")
    return ledger


def _render_row_for_distill(r):
    """Render one persisted session row to a compact line for distillation."""
    role = r.get("role", "")
    tn = r.get("toolName")
    c = r.get("content", "")
    if not isinstance(c, str):
        c = json.dumps(c)
    return f"{role}{('/' + tn) if tn else ''}: {c[:2000]}"


def distill_texts_chunked(texts, ledger, model, headers):
    """Distill a list of pre-rendered strings by PAGING them into <DISTILL_CHUNK_CHARS batches and
    accumulating into the ledger (merge_ledger dedups). This fixes the old one-shot behaviour where
    distill_into_ledger truncated old_text at DISTILL_INPUT_CAP (48000 chars) and SILENTLY DROPPED
    the middle of a long backlog — on a 1334-msg session that lost 6 of 7 hosts. Bounded by
    DISTILL_MAX_CHUNKS_PER_RUN so a giant backlog can't hang one resume; the remainder rolls into
    the next pass (callers advance _distilled_upto only by what was actually distilled).
    Returns (ledger, n_texts_distilled)."""
    batch, blen, nchunks, done = [], 0, 0, 0
    def flush():
        nonlocal ledger, batch, blen, nchunks, done
        if not batch:
            return
        ledger = distill_into_ledger("\n".join(batch), ledger, model, headers)
        nchunks += 1
        done += len(batch)
        batch, blen = [], 0
    for s in texts:
        if nchunks >= DISTILL_MAX_CHUNKS_PER_RUN:
            sys.stderr.write(f"[orchestrator] distill cap {DISTILL_MAX_CHUNKS_PER_RUN} chunks reached; "
                             f"{len(texts) - done} rows deferred to next pass\n")
            break
        if blen + len(s) > DISTILL_CHUNK_CHARS and batch:
            flush()
            continue_after_flush = nchunks >= DISTILL_MAX_CHUNKS_PER_RUN
            if continue_after_flush:
                sys.stderr.write(f"[orchestrator] distill cap {DISTILL_MAX_CHUNKS_PER_RUN} chunks reached; "
                                 f"{len(texts) - done} rows deferred to next pass\n")
                break
        batch.append(s)
        blen += len(s) + 1
    if nchunks < DISTILL_MAX_CHUNKS_PER_RUN:
        flush()
    return ledger, done


# ─────────────────── DSML / text tool-call parsing ───────────────────

# NOTE: some models (deepseek-v4-pro over OpenRouter) emit the DSML pipe as the FULLWIDTH
# vertical bar U+FF5C ("｜") instead of ASCII "|" (U+007C). The old regexes only matched
# ASCII, so a fullwidth-pipe tool call was NOT parsed → it leaked into the final text and
# silently ENDED the turn (observed live on retro2.vl turn -10). Match BOTH pipe forms.
_P = r"[|｜]"   # ASCII pipe OR fullwidth pipe
_DSML_INVOKE = re.compile(
    rf"<{_P}DSML{_P}invoke\s+name=\"(?P<name>[^\"]+)\">(?P<body>.*?)</{_P}DSML{_P}invoke>",
    re.DOTALL)
_DSML_PARAM = re.compile(
    rf"<{_P}DSML{_P}parameter\s+name=\"(?P<pname>[^\"]+)\"(?:\s+string=\"(?P<isstr>[^\"]*)\")?\s*>"
    rf"(?P<val>.*?)</{_P}DSML{_P}parameter>", re.DOTALL)
_DSML_BLOCK = re.compile(rf"<{_P}DSML{_P}tool_calls>.*?</{_P}DSML{_P}tool_calls>", re.DOTALL)
# Anthropic/XML-style fallback: <invoke name="x"><parameter name="y">v</parameter></invoke>
_XML_INVOKE = re.compile(
    r"<invoke\s+name=\"(?P<name>[^\"]+)\">(?P<body>.*?)</invoke>", re.DOTALL)
_XML_PARAM = re.compile(
    r"<parameter\s+name=\"(?P<pname>[^\"]+)\">(?P<val>.*?)</parameter>", re.DOTALL)


def _coerce(val: str, is_string_flag):
    val = val.strip()
    if is_string_flag == "true":
        return val
    # try to coerce non-string params (numbers/bools/json)
    low = val.lower()
    if low in ("true", "false"):
        return low == "true"
    try:
        if re.fullmatch(r"-?\d+", val):
            return int(val)
        if re.fullmatch(r"-?\d*\.\d+", val):
            return float(val)
    except ValueError:
        pass
    if val[:1] in "[{":
        try:
            return json.loads(val)
        except Exception:
            pass
    return val


def _accept_tool_name(name: str) -> bool:
    """Filter parsed tool-call names to REAL tools so prose like <invoke name="foo"> isn't
    mistaken for a call. BUT when the full toolset failed to load (TOOLS_OK False → _TOOL_NAMES
    empty or only the local recall tool), be permissive: parse the call anyway so a genuine
    tool call is surfaced (and dispatch can report it) instead of silently leaking into chat
    as raw text — which is the exact failure this parser exists to prevent."""
    if not TOOLS_OK or not _TOOL_NAMES:
        return True
    return name in _TOOL_NAMES


def parse_text_tool_calls(text: str):
    """Return (calls, cleaned_text). calls = [{name, input}]. Handles DSML + XML forms.
    Only returns calls whose name is a known tool (avoids false positives on prose)."""
    if not text:
        return [], text
    calls = []
    for inv in _DSML_INVOKE.finditer(text):
        name = inv.group("name").strip()
        args = {}
        for p in _DSML_PARAM.finditer(inv.group("body")):
            args[p.group("pname").strip()] = _coerce(p.group("val"), p.group("isstr"))
        if _accept_tool_name(name):
            calls.append({"name": name, "input": args})
    if calls:
        cleaned = _DSML_BLOCK.sub("", text)
        cleaned = _DSML_INVOKE.sub("", cleaned).strip()
        return calls, cleaned
    # XML-style fallback
    for inv in _XML_INVOKE.finditer(text):
        name = inv.group("name").strip()
        if not _accept_tool_name(name):
            continue
        args = {}
        for p in _XML_PARAM.finditer(inv.group("body")):
            args[p.group("pname").strip()] = _coerce(p.group("val"), "true")
        calls.append({"name": name, "input": args})
    if calls:
        cleaned = _XML_INVOKE.sub("", text).strip()
        return calls, cleaned
    return [], text


# ─────────────────── history reconstruction ───────────────────

def rows_to_openai(rows):
    """Flatten persisted session rows into OpenAI text messages (no formal tool pairing —
    avoids 400s and works for text-tool-call models). Tool activity becomes readable text."""
    out = []
    for m in rows:
        role = m.get("role")
        content = m.get("content", "")
        if not isinstance(content, str):
            content = json.dumps(content)
        if role == "assistant":
            if m.get("toolName") and not m.get("isResult"):
                out.append({"role": "assistant",
                            "content": f"[invoked tool {m.get('toolName')}: {content[:2000]}]"})
            elif content.strip():
                out.append({"role": "assistant", "content": content})
        elif role == "tool" or m.get("isResult"):
            out.append({"role": "user",
                        "content": f"[tool result {m.get('toolName','')}]: {content[:4000]}"})
        elif role == "user" and content.strip():
            out.append({"role": "user", "content": content})
    return out


def reconstruct(session_file, ledger, model, headers):
    """Hermes-style: restore the FULL prior conversation verbatim so the model is actually IN the
    conversation — not handed a distilled blob + the last few lines (that one-shot 'reconstruct
    every message' is exactly what made it feel automated/non-adaptive). An over-window session is
    compressed ONCE by the preflight maybe_compact() in main (middle-summary, protecting the opening
    + most-recent turns), never blindly truncated here. The ledger persists durable findings across
    turns/sessions as a SUPPLEMENT (kept current by the turn-end capture + maybe_compact); it no
    longer REPLACES the dialogue."""
    try:
        with open(session_file) as f:
            rows = json.load(f).get("messages", [])
    except Exception:
        rows = []
    return rows_to_openai(rows), ledger


def _safe_recent(conv):
    """Return a recent slice that does NOT start on an orphan tool message."""
    recent = conv[-KEEP_RAW_MSGS:]
    while recent and (recent[0].get("role") == "tool"):
        recent = recent[1:]
    return recent


# ───────────────────────── main ─────────────────────────

def main(prompt_override=None):
    global PROVIDER, _WARM_STATE, _WARM_LAST_END_REASON
    args = parse_args()
    PROVIDER = make_provider(args)   # openrouter (default) | openai-codex
    api_key = os.environ.get("OPENROUTER_API_KEY", "")
    session_id = "or-" + uuid.uuid4().hex[:8]
    emit({"type": "system", "subtype": "init", "model": args.model,
          "session_id": session_id, "cwd": args.cwd})
    # OpenRouter needs its API key; codex authenticates via the Hermes token store instead.
    if PROVIDER.name == "openrouter" and not api_key:
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True})
        emit({"type": "error", "message": "OPENROUTER_API_KEY not set"})
        sys.exit(1)

    try:
        with open(args.system_file) as f:
            system_text = f.read()
    except Exception:
        system_text = ""

    task_id = args.cwd or "chillspwn"
    headers = PROVIDER.auth_headers()

    window = get_context_window(args.model, headers)
    budget = int(window * COMPACT_AT)
    ledger = load_ledger(args.session_file)
    seeded, ledger = reconstruct(args.session_file, ledger, args.model, headers)  # FULL verbatim history (fast load, no per-turn distill)

    # messages[0]=system prompt, [1]=ledger state, [2:]=conversation
    messages = []
    if system_text.strip():
        messages.append({"role": "system", "content": system_text.strip()})
    else:
        messages.append({"role": "system", "content": "You are ChillsPwn."})
    # Append the SKILLS INDEX to the system prompt (messages[0]) so it rides with the stable head
    # and is never compacted away. The use_skill tool loads any listed skill's full SKILL.md.
    if _SKILLS_INDEX:
        messages[0]["content"] += "\n\n" + render_skills_index(_SKILLS_INDEX)
    messages.append({"role": "system", "content": render_ledger(ledger)})
    messages.extend(seeded)
    # If the operator accepted the post-completion report offer ("Generate the report"), turn this
    # turn into a report-generation run via the pentest-report-pdf skill (reliable, not improvised).
    _user_prompt = prompt_override if prompt_override is not None else args.prompt
    if re.search(r"\bgenerate the (pentest )?report\b", _user_prompt or "", re.I):
        _user_prompt += (
            "\n\n[REPORT DIRECTIVE: Load the `pentest-report-pdf` skill with use_skill, then generate the "
            "professional pentest report from THIS engagement's findings — the ledger's hosts / credentials "
            "/ vulns / flags + the loot/notes/scans in the engagement directory. Write it into the "
            "engagement's report/ subdirectory, then reply with the report file path. Do this now.]")
    messages.append({"role": "user", "content": _user_prompt})

    # ── Tier 2 warm continuation: if a prior turn left in-memory state, REUSE it (the cold rebuild
    # above still ran — it's cheap now that reconstruct doesn't distill — but we discard it in favour
    # of the live, already-compacted thread). This is what makes a follow-up CONTINUE the conversation
    # rather than reconstruct it. No-op unless CHILLSPWN_OR_WARM=1 and a prior turn ran. ──
    if _WARM_ENABLED and _WARM_STATE is not None:
        messages = _WARM_STATE["messages"]
        ledger = _WARM_STATE.get("ledger") or ledger
        messages.append({"role": "user", "content": _user_prompt})

    # ── Engagement mode (Guided coaching vs Autonomous; autonomous is the HARD default) ──
    # In Guided mode the operator runs the commands; the agent COACHES. Enforce it for real by
    # removing the execution tools from this turn's tool list (prompt text alone was cosmetic) and
    # injecting a coaching instruction. Autonomous = unchanged behavior (full tool list).
    _eng_mode = _detect_engagement_mode(args.session_file)
    if _eng_mode == "guided":
        _active_tools = [t for t in _OPENAI_TOOLS
                         if ((t.get("function") or {}).get("name")) not in _GUIDED_EXEC_BLOCK]
        messages.insert(2, {"role": "system", "content":
            "## ENGAGEMENT MODE: GUIDED (coaching). The operator chose Guided Mode, so you are a "
            "COACH — NOT an autonomous operator. The execution tools (terminal, execute_code, "
            "process, patch, write_file) are DISABLED this turn; you cannot run commands yourself. "
            "For each step: say WHAT to run and WHY, give the operator the EXACT command, then STOP "
            "and WAIT for their pasted output before the next step. Hand control back at every "
            "decision point / phase boundary by emitting a <user-question>. You MAY still read_file, "
            "search_files, web_search, recall_conversation, and use_skill to inform your guidance. "
            "One coached step at a time — never auto-drive the chain."})
        emit_status("Guided mode — coaching (execution tools disabled)")
    else:
        _active_tools = _OPENAI_TOOLS

    # Context chip: surface WHAT memory/context was injected into THIS turn — the passive
    # "the model is referring to the MCP/memory" signal, distinct from an explicit recall_conversation.
    # kind:"context" so the frontend renders it as a small persistent chip (not the transient label).
    try:
        _findings = (len(ledger.get("credentials") or []) + len(ledger.get("vulns") or [])
                     + len(ledger.get("flags") or []) + len(ledger.get("key_facts") or [])
                     + len(ledger.get("hosts") or {}))
        _has_mem = ("PERSISTENT MEMORY" in system_text or "USER PREFERENCES" in system_text)
        emit({"type": "status", "kind": "context",
              "text": f"🧠 Context loaded — {_findings} ledger findings"
                      + (" + persistent memory" if _has_mem else "")
                      + f" + {len(seeded)} recent turns in window"})
    except Exception:
        pass

    # Auto memory-promotion state: per-session dedup set + a counter of tools used this turn (gates the
    # end-of-turn capture). Promote anything durable already in the loaded ledger (resumed sessions).
    _promoted_mem = set()
    _turn_tools = [0]
    try:
        _np = _promote_durable_to_memory(ledger, _promoted_mem, _extract_memory_sections(messages), session_id)
        if _np:
            emit({"type": "assistant", "message": {
                "id": f"msg_{session_id}_mem0_{uuid.uuid4().hex[:6]}", "model": args.model,
                "content": [{"type": "text", "text": "💾 Auto-saved to global memory: " + "; ".join(s[:90] for s in _np[:6])}]}})
    except Exception as e:
        sys.stderr.write(f"[orchestrator] startup promote failed: {e}\n")

    start = time.time()
    usage_total = {"prompt_tokens": 0, "completion_tokens": 0}
    model_used = args.model

    def acc_usage(u):
        if u:
            usage_total["prompt_tokens"] += u.get("prompt_tokens", 0) or 0
            usage_total["completion_tokens"] += u.get("completion_tokens", 0) or 0

    def maybe_compact():
        """Keep-raw-until-compaction: when the live context exceeds budget, distill the
        older conversation (everything between the two system msgs and the recent window)
        into the ledger and drop it from context."""
        nonlocal messages, ledger
        if estimate_tokens(messages) <= budget:
            return False
        head = messages[:2]                  # system prompt + ledger state
        conv = messages[2:]
        if len(conv) <= KEEP_RAW_MSGS:
            return False
        recent = _safe_recent(conv)
        protect_first = conv[:PROTECT_FIRST_MSGS]                 # keep the OPENING (objective/target/mode) verbatim
        old = conv[len(protect_first):len(conv) - len(recent)]    # only the MIDDLE is distilled away (Hermes-style)
        if not old:
            return False
        emit_status("Compacting context — summarizing the middle of a long conversation…")
        texts = [
            (f"{m.get('role')}: " +
             (m.get('content') if isinstance(m.get('content'), str) else json.dumps(m.get('content')))[:2000] +
             (f" [tool_calls={json.dumps(m['tool_calls'])[:500]}]" if m.get('tool_calls') else ""))
            for m in old]
        ledger, _ = distill_texts_chunked(texts, ledger, args.model, headers)
        save_ledger(args.session_file, ledger)
        try:
            _nc = _promote_durable_to_memory(ledger, _promoted_mem, _extract_memory_sections(messages), session_id)
            if _nc:
                emit({"type": "assistant", "message": {
                    "id": f"msg_{session_id}_memc_{uuid.uuid4().hex[:6]}", "model": model_used,
                    "content": [{"type": "text", "text": "💾 Auto-saved to global memory: " + "; ".join(s[:90] for s in _nc[:6])}]}})
        except Exception as e:
            sys.stderr.write(f"[orchestrator] compaction promote failed: {e}\n")
        messages = [head[0], {"role": "system", "content": render_ledger(ledger)}] + protect_first + recent
        emit({"type": "assistant", "message": {
            "id": f"msg_{session_id}_compact_{uuid.uuid4().hex[:6]}",
            "model": model_used,
            "content": [{"type": "text",
                         "text": f"🗜 Context compacted — distilled {len(old)} older turns "
                                 f"into the findings ledger to keep context lean."}]}})
        return True

    def run_one_tool(name, a, it, tag):
        """Execute one tool call, emit tool_use + tool_result cards, return result str."""
        tcid = f"call_{uuid.uuid4().hex[:8]}"
        emit({"type": "assistant", "message": {
            "id": f"msg_{session_id}_{it}_{tag}_{tcid}", "model": model_used,
            "content": [{"type": "tool_use", "id": tcid, "name": name, "input": a}]}})
        res = _run_tool(name, a)
        res = res[:TOOL_RESULT_CAP]
        _turn_tools[0] += 1
        emit({"type": "user", "message": {
            "content": [{"type": "tool_result", "tool_use_id": tcid, "content": res}]}})
        if cr is not None:
            cr.append(task_id, {"role": "tool", "toolName": name, "content": res})
        return name, a, res

    def delegate_task(task, tools=None, max_iters=None, model=None):
        """#57 — spawn a CHILD orchestrator to run a focused sub-task in an ISOLATED context,
        then return its result. Bounded budget; optional tool whitelist; no recursion (child is
        depth+1 → has no delegate_task). Blocking: returns when the sub-agent finishes."""
        task = (task or "").strip()
        if not task:
            return "Error: 'task' is required for delegate_task."
        import tempfile, subprocess
        sf = tempfile.NamedTemporaryFile("w", suffix=".subagent.json", delete=False)
        json.dump({"messages": []}, sf); sf.close()
        syf = tempfile.NamedTemporaryFile("w", suffix=".subsys.txt", delete=False)
        syf.write(
            "You are a focused ChillsPwn SUB-AGENT spawned by the lead agent to complete ONE "
            "specific task autonomously. You have the same tools and skills (terminal, files, "
            "use_skill, recall_conversation). There is NO user to ask — act with your tools until "
            "the task is done, then end your final reply with <<OBJECTIVE_COMPLETE>> followed by "
            "the concrete result/findings the lead agent needs. Stay strictly on this task.")
        syf.close()
        env = dict(os.environ)
        env["CHILLSPWN_OR_SUBAGENT_DEPTH"] = str(_SUBAGENT_DEPTH + 1)
        env["CHILLSPWN_OR_STREAM"] = "0"                   # child output is captured, not streamed
        env["CHILLSPWN_OR_AUTO_CONTINUE_SECONDS"] = "600"  # cap the sub-agent's wall-clock
        try:
            mi = int(max_iters) if max_iters else 40
        except (TypeError, ValueError):
            mi = 40
        env["CHILLSPWN_OR_MAX_ITERS"] = str(max(1, min(mi, 200)))
        if tools:
            env["CHILLSPWN_OR_TOOL_WHITELIST"] = tools if isinstance(tools, str) else ",".join(str(t) for t in tools)
        cmd = ["python3", os.path.abspath(__file__),
               "--model", (model or args.model), "--prompt", task,
               "--system-file", syf.name, "--session-file", sf.name, "--cwd", args.cwd]
        timed_out = False
        try:
            proc = subprocess.run(cmd, env=env, capture_output=True, text=True,
                                  timeout=900, start_new_session=True)
            out = proc.stdout or ""
        except subprocess.TimeoutExpired as e:
            timed_out = True
            out = (e.stdout if isinstance(e.stdout, str) else (e.stdout.decode("utf-8", "replace") if e.stdout else "")) or ""
        finally:
            for p in (sf.name, syf.name, sf.name + ".ledger.json"):
                try: os.unlink(p)
                except Exception: pass
        final, ntools, end_reason = "", 0, None
        for line in out.splitlines():
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            t = e.get("type")
            if t == "assistant":
                for b in (e.get("message", {}).get("content") or []):
                    if b.get("type") == "tool_use":
                        ntools += 1
                    elif b.get("type") == "text" and (b.get("text") or "").strip():
                        final = b["text"]
            elif t == "result":
                end_reason = e.get("end_reason")
        final = final.replace(DONE_SENTINEL, "").strip()
        head = f"[delegated sub-agent — {ntools} tool calls, end={end_reason}{', TIMED OUT' if timed_out else ''}]"
        return (head + "\n" + (final or "(sub-agent produced no text result)"))[:TOOL_RESULT_CAP]

    def _run_tool(name, a):
        # recall_conversation is a LOCAL tool. It now searches THREE sources and returns them
        # as labeled, budget-split sections: the live findings-ledger (incl. commands already
        # run), the persistent memory (USER.md + MEMORY.md, inlined in the system prompt), and
        # the durable append-only conversation.mcp log. Budget-aware against remaining context.
        if name == "recall_conversation":
            query = a.get("query", "") or ""
            terms = [t.lower() for t in re.findall(r"\w+", query) if len(t) > 2]
            headroom = max(2000, budget - estimate_tokens(messages))
            mt = min(int(a.get("max_tokens") or headroom), headroom)
            third_chars = max(1000, (mt * 4) // 3)   # ~1/3 of the token budget, expressed in chars
            parts = []
            led = _kw_filter("\n".join(_render_ledger_body(ledger)), terms, third_chars)
            if led.strip():
                parts.append("### From engagement state (ledger)\n" + led)
            mem = _kw_filter(_extract_memory_sections(messages), terms, third_chars)
            if mem.strip():
                parts.append("### From persistent memory\n" + mem)
            if cr is not None:
                try:
                    log_hit = cr.recall(task_id, query, max(1500, mt // 3))
                except Exception as e:
                    log_hit = f"(conversation log recall failed: {e})"
                if log_hit and log_hit.strip():
                    parts.append("### From conversation log\n" + log_hit)
            return "\n\n".join(parts) if parts else f"(nothing recalled for {query!r})"
        # use_skill / skill_manage are LOCAL tools — load or create/patch SKILL.md playbooks.
        if name == "use_skill":
            return load_skill_text(a.get("skill") or a.get("name") or "")
        if name == "skill_manage":
            return skill_manage(a.get("action"), a.get("name"), a.get("description"),
                                a.get("content"), a.get("mode", "append"))
        # remember writes a durable fact to GLOBAL memory now (gated + deduped against current memory).
        if name == "remember":
            return _remember(a.get("text") or a.get("fact") or "", a.get("target") or "memory",
                             session_id, _extract_memory_sections(messages))
        # delegate_task spawns a child orchestrator (LOCAL — bounded, no recursion).
        if name == "delegate_task":
            return delegate_task(a.get("task"), a.get("tools"), a.get("max_iters"), a.get("model"))
        # board_* tools fan work out to OTHER agents via the dashboard kanban (parallel, then gather).
        if name == "board_create_task":
            return board_create_task(a.get("agent"), a.get("title"), a.get("body"), a.get("engagement"), args.model)
        if name == "board_await":
            return board_await(a.get("card_ids"), a.get("timeout"))
        if name == "board_list":
            return board_list()
        if name == "board_update":
            return board_update(a.get("card_id"), a.get("status"), a.get("assignee"))
        if TOOLS_OK:
            r = _dispatch_guarded(name, a)
        else:
            r = json.dumps({"error": "tools unavailable", "detail": TOOLS_ERR})
        return r if isinstance(r, str) else str(r)

    def _dispatch_guarded(name, a):
        """Run an external tool with a HARD wall-clock timeout so a tool that ignores its own
        timeout (e.g. process-wait on a never-exiting background server — the 09:26 freeze) can't
        hang the entire turn. On timeout we ABANDON the call (its daemon worker thread dies with the
        process) and return a synthetic result, so the agentic loop RECOVERS and picks another path."""
        box = {}
        done = threading.Event()
        def _worker():
            try:
                box["r"] = ct.dispatch(name, a, task_id=task_id)
            except Exception as e:
                box["r"] = json.dumps({"error": f"{type(e).__name__}: {e}"})
            finally:
                done.set()
        threading.Thread(target=_worker, daemon=True).start()
        if not done.wait(TOOL_HARD_TIMEOUT):
            _dispatch_guarded._to = getattr(_dispatch_guarded, "_to", 0) + 1
            _escalate = _dispatch_guarded._to >= 2
            sys.stderr.write(f"[orchestrator] tool {name} exceeded {TOOL_HARD_TIMEOUT}s — abandoned, recovering "
                             f"(consecutive timeouts={_dispatch_guarded._to})\n")
            emit({"type": "assistant", "message": {
                "id": f"msg_{session_id}_twd_{uuid.uuid4().hex[:6]}", "model": model_used,
                "content": [{"type": "text", "text":
                    f"⚠ Auto-recovery: `{name}` ran past {TOOL_HARD_TIMEOUT}s with no result "
                    f"(likely a blocking / never-returning command). Abandoning it and continuing "
                    f"with a different approach."
                    + (f" This is timeout #{_dispatch_guarded._to} in a row — STOP waiting on long jobs: "
                       f"background them and do a short non-blocking check, or if you are blocked, ask the "
                       f"operator or summon the council instead of waiting again." if _escalate else "")}]}})
            return json.dumps({"error": "tool_timeout", "tool": name, "timeout_s": TOOL_HARD_TIMEOUT,
                "consecutive_timeouts": _dispatch_guarded._to,
                "detail": (f"'{name}' did not return within {TOOL_HARD_TIMEOUT}s and was ABANDONED "
                           "(it may still be running in the background). Do NOT re-run it the same "
                           "way. If you launched a long or never-exiting process, start it with "
                           "background=true and do a SHORT non-blocking check instead of waiting on "
                           "it; otherwise take a different approach."
                           + (" Multiple consecutive timeouts — do NOT wait on another long job; background "
                              "it and proceed, or stop and ask the operator." if _escalate else ""))})
        _dispatch_guarded._to = 0   # a tool that returned in time resets the consecutive-timeout run
        return box.get("r", "")

    def chat_completion(body, it):
        """One model call. Streams tokens live (emitting stream_event deltas the dashboard
        renders) when enabled, else one-shot http_post. Returns the http_post-shaped response
        either way, so all Path A/B/C loop logic below is identical regardless of streaming.
        The streamed text bubble is keyed by msg_{session_id}_{it} so the consolidated
        assistant text event (same id, emitted below) reconciles onto it instead of duplicating."""
        if not STREAM_TOKENS:
            return http_post(PROVIDER.chat_url, headers, body)
        text_msg_id = f"msg_{session_id}_{it}"
        st = {"started": False, "suppress": False, "emitted": 0, "acc": ""}

        def ensure_start():
            if not st["started"]:
                st["started"] = True
                emit({"type": "stream_event", "event": {
                    "type": "message_start", "message": {"id": text_msg_id}}})
                emit({"type": "stream_event", "event": {
                    "type": "content_block_start", "index": 0, "content_block": {"type": "text"}}})

        def emit_text(s):
            if not s:
                return
            ensure_start()
            emit({"type": "stream_event", "event": {
                "type": "content_block_delta", "index": 0,
                "delta": {"type": "text_delta", "text": s}}})

        def on_text(chunk):
            # Stream visible text, but stop once a tool-call-as-text marker appears so raw
            # DSML/XML markup doesn't flash in the UI (the cleaned consolidated text + tool
            # card replace it). Pre-marker reasoning still streams for the "alive" feel. A
            # holdback tail is withheld each chunk so a marker split across chunk boundaries
            # (e.g. "<｜DS" | "ML｜…") never leaks even its prefix.
            if st["suppress"] or not chunk:
                return
            st["acc"] += chunk
            combined = st["acc"]
            hits = [combined.find(m) for m in _STREAM_TOOL_MARKERS]
            hits = [p for p in hits if p >= 0]
            if hits:
                marker = min(hits)
                if marker > st["emitted"]:
                    emit_text(combined[st["emitted"]:marker])
                    st["emitted"] = marker
                st["suppress"] = True
                return
            safe = len(combined) - _STREAM_HOLDBACK   # hold back a possible marker prefix
            if safe > st["emitted"]:
                emit_text(combined[st["emitted"]:safe])
                st["emitted"] = safe

        resp = stream_post(PROVIDER.chat_url, headers, body, on_text)
        # No marker ever appeared → flush the held-back tail so the full text streamed.
        if not st["suppress"] and st["emitted"] < len(st["acc"]):
            emit_text(st["acc"][st["emitted"]:])
            st["emitted"] = len(st["acc"])
        if st["started"]:
            emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}})
        return resp

    def _codex_stream_emitter(it):
        """For codex turns: wrap text chunks as the SAME stream_event deltas the dashboard renders
        for OpenRouter (message_start once, content_block_delta per chunk, content_block_stop at
        end), keyed by msg_{session_id}_{it} so the consolidated assistant text reconciles onto it."""
        tmid = f"msg_{session_id}_{it}"
        st = {"started": False}
        def ed(s):
            if not s:
                return
            if not st["started"]:
                st["started"] = True
                emit({"type": "stream_event", "event": {"type": "message_start", "message": {"id": tmid}}})
                emit({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": {"type": "text"}}})
            emit({"type": "stream_event", "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": s}}})
        def fin():
            if st["started"]:
                emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}})
        return ed, fin

    def model_call(messages_, it, *, tools=None, temperature=0.7, stream=True):
        """ONE model call, provider-routed. OpenRouter keeps its exact existing path (build_body +
        chat_completion) untouched; codex (different API — Responses) goes through PROVIDER.complete
        with the same streamed-delta emission so the loop's parse_choice/Path-A logic is identical."""
        if PROVIDER.name == "codex":
            ed, fin = (_codex_stream_emitter(it) if (stream and STREAM_TOKENS) else (None, None))
            j = PROVIDER.complete(args.model, messages_, tools=tools, max_tokens=MAX_TOKENS,
                                  temperature=temperature, on_text=ed)
            if fin:
                fin()
            return j
        body = PROVIDER.build_body(args.model, messages_, max_tokens=MAX_TOKENS,
                                   temperature=temperature, tools=tools)
        return chat_completion(body, it)

    def summarize_and_emit():
        """Hermes-parity ceiling recovery (port of chat_completion_helpers.handle_max_iterations):
        when the turn hits the safety ceiling / loop guard, make ONE final model call with the
        TOOLS STRIPPED, asking for a concise wrap-up + the next concrete step. The model can't
        call a tool, so it must answer in prose — the user gets a clean recap instead of an
        abrupt pause, and re-prompting resumes from the ledger. Streams + persists like any turn."""
        messages.append({"role": "user", "content":
            "You've been working autonomously for an extended session and reached a checkpoint "
            "(NOT the end of the engagement). Reply with NO tool calls: (1) briefly summarize what "
            "you found and accomplished, then (2) state the single most important NEXT step. Send "
            "a message to keep going and you'll resume from exactly here."})
        # Deliberately NO "tools"/"tool_choice" in the body → the model must answer in prose.
        j = model_call(messages, "final", tools=None, temperature=0.5)
        acc_usage(j.get("usage"))
        raw = (PROVIDER.parse_choice(j)[0] or "").strip()
        if not raw:
            return
        # The model has no tools to run; if it typed tool-call markup anyway, strip it — but if
        # stripping leaves nothing (a pure-markup reply), fall back to the raw text so the user
        # still gets a recap rather than silence.
        _, cleaned = parse_text_tool_calls(raw)
        out = cleaned.strip() if (cleaned and cleaned.strip()) else raw
        emit({"type": "assistant", "message": {
            "id": f"msg_{session_id}_final", "model": model_used,
            "content": [{"type": "text", "text": out}]}})
        if cr is not None:
            cr.append(task_id, {"role": "assistant", "content": out})

    # Log this turn's user prompt to the durable engagement log.
    if cr is not None:
        cr.append(task_id, {"role": "user", "content": args.prompt})

    end_reason = "final"
    maybe_compact()   # preflight: if a RESUMED session already exceeds the token budget, compress
                      # ONCE (middle-summary, protecting opening + recent) before the first model
                      # call — mirrors Hermes' preflight compression. A within-budget session is
                      # left fully intact, so the model sees the whole real conversation.
    last_sig = None
    dup_count = 0
    continue_budget = CONTINUE_BUDGET   # Hermes-parity: remaining Path-C continuation nudges
    length_conts = 0                    # max_tokens-truncation continuations used this turn
    nudge_stall = 0                     # consecutive nudges that produced ~identical no-tool text
    last_nudge_text = None

    # Detect "promise without action" — the model narrates intent ("let me verify…",
    # "I'll try…", trailing ':') but emits NO tool call, so Path C would end the turn early.
    _INTENT = re.compile(
        r"(?:^|\n)\s*(?:let me\b|let's\b|i'?ll\b|i will\b|i'?m going to\b|going to\b|"
        r"next,? i\b|now i\b|let me try\b|let me verify\b|let me check\b)",
        re.I)
    # Detect "asks permission / waits for go-ahead" stalls. The engagement is operator-
    # authorized + autonomous, so these should auto-proceed (Hermes drives forward; it does
    # not pause to ask "want me to continue?"). 8/37 retro2.vl turns died on exactly this.
    # NOTE: bare "should i"/"shall i" is too broad (it swallows genuine choice questions like
    # "which subnet should I focus on?"), so permission requires a CONTINUATION verb.
    _PERMISSION = re.compile(
        r"(want me to\b|would you like (me )?to\b|do you want me to\b|let me know (if|when|whether)\b|"
        r"if you'?d like\b|ready to proceed\b|\bproceed\?|\bcontinue\?|i can (reconnect|push|fire|try|run|elevate|pick)\b|"
        r"sh(all|ould) i (proceed|continue|go ahead|keep going|go on|start|begin|run|try|do it|move on)\b)",
        re.I)
    # A genuine choice that only the user can make → END the turn so they can answer. Checked
    # BEFORE permission, because "which … should I …?" contains "should i".
    _CHOICE_Q = re.compile(
        r"\bwhich\b|\bwhat (would|should|do) you\b|\bdo you (prefer|want)\b.*\bor\b",
        re.I)
    def looks_like_intent_to_act(t):
        if not t:
            return False
        s = t.strip()
        return bool(_INTENT.search(s)) or s.endswith(":")

    # GOAL-DRIVEN completion (DONE_SENTINEL is module-level). The agent works autonomously and
    # the loop does NOT stop just because the model emitted a no-tool message (that was the old,
    # unreliable signal). It stops ONLY when it explicitly declares the objective achieved by
    # emitting the sentinel, OR asks a question only the user can answer. Else = "still working".
    def classify_stop(t):
        """Decide what a no-tool message means.
          done       → the agent emitted the completion sentinel → STOP (objective achieved)
          question   → a genuine decision only the user can make → STOP so they can answer
          permission → "want me to continue?" stall → CONTINUE (authorized autonomy)
          intent     → narrated a next step but didn't act → CONTINUE (act now)
          progress   → any other summary/narration → CONTINUE (NOT a stopping point)"""
        s = (t or "").strip()
        if DONE_SENTINEL in s:                          # explicit objective completion → STOP
            return "done"
        if s.endswith("?") and _CHOICE_Q.search(s):     # genuine user-only choice → STOP
            return "question"
        if not s:
            return "progress"
        if _PERMISSION.search(s):
            return "permission"
        if looks_like_intent_to_act(s):
            return "intent"
        if s.endswith("?"):
            return "question"
        return "progress"                                # ambiguous summary, NOT done → CONTINUE

    def _norm(s):
        return re.sub(r"\s+", " ", (s or "").strip())[:240].lower()

    try:
        for it in range(SAFETY_CEILING):
            # Autonomous-continuation checkpoints: keep going on our own. Every COMPACT_EVERY
            # iterations, compact context and post a brief progress note (so a long self-driven
            # run stays lean and visibly alive). Pause ONLY when we've been working autonomously
            # for the full AUTO_CONTINUE_SECONDS window — then summarize_and_emit() posts a
            # resumable checkpoint. Genuine completion / a real question / a loop still end the
            # turn earlier (Path C / loop_detected below).
            if it > 0 and it % COMPACT_EVERY == 0:
                maybe_compact()
                emit({"type": "assistant", "message": {
                    "id": f"msg_{session_id}_ck{it}", "model": model_used,
                    "content": [{"type": "text",
                                 "text": f"⟳ Working autonomously — {it} tool-iterations in; "
                                         f"context compacted, continuing without pause."}]}})
            if time.time() - start > AUTO_CONTINUE_SECONDS:
                end_reason = "safety_ceiling"
                break
            j = model_call(messages, it, tools=(_active_tools if TOOLS_OK else None), temperature=0.7)
            acc_usage(j.get("usage"))
            if j.get("model"):
                model_used = j["model"]
            text, tcs, finish_reason, _ = PROVIDER.parse_choice(j)

            # --- Blocking question gate (checked BEFORE any tool dispatch) ---
            # A genuine question to the operator and an action are mutually exclusive. If the model
            # emitted a <user-question> block (the dashboard renders it as buttons), SURFACE it and
            # STOP — never run accompanying tool_calls and barrel past the question. This is what
            # makes the engagement-mode prompt, the target-confirm, and any decision-point check-in
            # ACTUALLY pause for the operator (end_reason="question" → server stops, no auto-resume)
            # instead of being cosmetic text the autonomous loop steamrolls.
            if text and "<user-question>" in text and "</user-question>" in text:
                _qt = text.replace(DONE_SENTINEL, "").rstrip()
                emit({"type": "assistant", "message": {
                    "id": f"msg_{session_id}_{it}_q", "model": model_used,
                    "content": [{"type": "text", "text": _qt}]}})
                if cr is not None:
                    cr.append(task_id, {"role": "assistant", "content": _qt})
                end_reason = "question"
                break

            # --- Path A: native OpenAI tool_calls ---
            if tcs:
                if text.strip():
                    emit({"type": "assistant", "message": {
                        "id": f"msg_{session_id}_{it}", "model": model_used,
                        "content": [{"type": "text", "text": text}]}})
                    _emit_activity(text)   # reuse the model's own narration as the live activity label
                messages.append({"role": "assistant", "content": text, "tool_calls": tcs})
                for tc in tcs:
                    fn = tc.get("function") or {}
                    name = fn.get("name") or "tool"
                    tcid = tc.get("id") or f"call_{uuid.uuid4().hex[:8]}"
                    try:
                        a = json.loads(fn.get("arguments") or "{}")
                    except Exception:
                        a = {}
                    emit({"type": "assistant", "message": {
                        "id": f"msg_{session_id}_{it}_tu_{tcid}", "model": model_used,
                        "content": [{"type": "tool_use", "id": tcid, "name": name, "input": a}]}})
                    res = _run_tool(name, a)[:TOOL_RESULT_CAP]
                    emit({"type": "user", "message": {
                        "content": [{"type": "tool_result", "tool_use_id": tcid, "content": res}]}})
                    messages.append({"role": "tool", "tool_call_id": tcid, "name": name, "content": res})
                    if cr is not None:
                        cr.append(task_id, {"role": "tool", "toolName": name, "content": res})
                # Loop-guard (parity with Path B below): if the model re-issues the SAME native
                # tool_call(s) with no change across iterations it is spinning (e.g. re-polling a
                # hung process, re-running an identical command) — trip loop_detected instead of
                # burning the whole safety ceiling. Compares the call signature (name+raw args),
                # NOT the result, so a poll that returns fresh output every time still counts as
                # the same action. This is the gap that let native-tool_call models (gpt-5.5,
                # most OpenRouter models) loop unchecked for ~24h.
                _sigA = json.dumps(
                    [[(tc.get("function") or {}).get("name"),
                      (tc.get("function") or {}).get("arguments") or ""] for tc in tcs],
                    sort_keys=True)
                if _sigA == last_sig:
                    dup_count += 1
                else:
                    dup_count = 0; last_sig = _sigA
                if dup_count >= 3:
                    end_reason = "loop_detected"; break
                continue_budget = CONTINUE_BUDGET   # real progress → refill the no-action budget
                maybe_compact()
                continue

            # --- Path B: tool calls embedded as TEXT (DSML / XML) ---
            text_calls, cleaned = parse_text_tool_calls(text)
            if text_calls:
                if cleaned.strip():
                    emit({"type": "assistant", "message": {
                        "id": f"msg_{session_id}_{it}", "model": model_used,
                        "content": [{"type": "text", "text": cleaned}]}})
                    _emit_activity(cleaned)   # reuse the model's narration as the live activity label
                # record the assistant's (cleaned) reasoning so context stays coherent
                messages.append({"role": "assistant",
                                 "content": cleaned or "(issued tool calls)"})
                for call in text_calls:
                    name, a, res = run_one_tool(call["name"], call.get("input") or {}, it, "txt")
                    # feed result back as plain text (no tool_call_id → no OpenAI pairing 400)
                    messages.append({"role": "user",
                                     "content": f"[tool result {name}]:\n{res}"})
                    sig = json.dumps([name, a], sort_keys=True)
                    if sig == last_sig:
                        dup_count += 1
                    else:
                        dup_count = 0; last_sig = sig
                if dup_count >= 3:
                    end_reason = "loop_detected"; break
                continue_budget = CONTINUE_BUDGET   # real progress → refill the no-action budget
                maybe_compact()
                continue

            # --- Path C: no tool calls anywhere ---
            decision = classify_stop(text)
            # Never show the raw control sentinel to the user.
            display_text = (text.replace(DONE_SENTINEL, "").rstrip() if text else text)
            if display_text and display_text.strip():
                emit({"type": "assistant", "message": {
                    "id": f"msg_{session_id}_{it}", "model": model_used,
                    "content": [{"type": "text", "text": display_text}]}})
                if cr is not None:
                    cr.append(task_id, {"role": "assistant", "content": display_text})

            # Length-continuation: a response cut off by the max_tokens cap is INCOMPLETE, never
            # a completion — continue it exactly where it stopped.
            if decision != "done" and finish_reason == "length" and length_conts < MAX_LENGTH_CONTINUATIONS:
                length_conts += 1
                messages.append({"role": "assistant", "content": text or "(continuing)"})
                messages.append({"role": "user", "content":
                    "Your previous message was cut off by the length limit. Continue exactly "
                    "where you left off — do not repeat what you already wrote."})
                continue

            # GOAL HIT: the agent declared the objective achieved → stop and report.
            if decision == "done":
                emit({"type": "assistant", "message": {
                    "id": f"msg_{session_id}_{it}_done", "model": model_used,
                    "content": [{"type": "text", "text": "✅ Objective complete — stopping."}]}})
                # REPORT AUTO-OFFER: only for real engagements (the ledger holds findings/flags), so
                # trivial completions don't prompt. The <user-question> renders buttons; choosing
                # "Generate the report" comes back as a follow-up that the report directive (top of
                # run()) turns into a pentest-report-pdf skill run.
                if (ledger.get("flags") or ledger.get("credentials") or ledger.get("vulns")):
                    emit({"type": "assistant", "message": {
                        "id": f"msg_{session_id}_report_offer", "model": model_used,
                        "content": [{"type": "text", "text":
                            "📄 Engagement complete. Generate the pentest report from these findings?\n"
                            "<user-question>\n"
                            '{"question": "Generate the pentest report now?", "options": ['
                            '{"label": "Generate the report", "description": "Build the report from this engagement\'s findings via the pentest-report-pdf skill"}, '
                            '{"label": "Not now", "description": "Skip — you can generate it later from the Engagements page"}]}\n'
                            "</user-question>"}]}})
                end_reason = "completed"
                break

            # GOAL-DRIVEN continue-by-default: anything that is NOT an explicit completion or a
            # real user-only question means "still working" → drive forward autonomously. Bounded
            # by continue_budget (resets on real tool use), the nudge-stall guard, and the
            # auto-continue window — so genuine progress never trips it, but pure no-action chatter
            # eventually does.
            if decision in ("intent", "permission", "progress") and continue_budget > 0:
                if last_nudge_text is not None and _norm(text) == last_nudge_text:
                    nudge_stall += 1
                else:
                    nudge_stall = 0
                if nudge_stall >= NUDGE_STALL_LIMIT:
                    end_reason = "stuck"          # repeating the same no-tool text → genuinely stuck
                    break
                last_nudge_text = _norm(text)
                continue_budget -= 1
                messages.append({"role": "assistant", "content": text or "(continuing)"})
                messages.append({"role": "user", "content":
                    "Keep going — you have NOT signalled completion, so the objective is not done. "
                    "Issue your next tool call NOW and do not wait for the user. If (and ONLY if) "
                    "the objective is FULLY achieved, reply with the token <<OBJECTIVE_COMPLETE>> on "
                    "its own line followed by the result (e.g. the captured flag/proof). If you "
                    "genuinely need a decision only the user can make, ask ONE concise question. A "
                    "plain progress summary is NOT a stopping point — continue working."})
                continue

            # Distinguish the two ways we get here so the server can react correctly:
            #   • a genuine user-only question  → "question" → STOP, wait for the operator (no auto-resume)
            #   • no-action budget/stall spent  → "stuck"    → STOP + offer the council
            # (Never the old ambiguous "final", which the auto-resume logic couldn't classify.)
            end_reason = "question" if decision == "question" else "stuck"
            break
        else:
            # The for-loop ran the full SAFETY_CEILING without a break — treat like the timer
            # checkpoint: timed out mid-work, still has momentum → server auto-resumes.
            end_reason = "safety_ceiling"

        # Hermes-parity ceiling recovery: on an abrupt stop (safety ceiling or loop guard),
        # emit ONE final tools-stripped summary turn so the pause comes with a clean recap +
        # next step instead of stopping cold. Best-effort; never blocks the result event.
        if end_reason in ("safety_ceiling", "loop_detected", "stuck"):
            try:
                summarize_and_emit()
            except Exception as e:
                sys.stderr.write(f"[orchestrator] ceiling summary failed: {e}\n")
        # GENUINELY STUCK (a detected loop or an exhausted nudge budget — NOT just the autonomous
        # timer): stop and offer the operator the council as a one-tap next action. The frontend
        # parses the <user-question> block into option buttons (→ "I choose: Summon the council",
        # which DeepSeek then runs via the council-of-ais skill). safety_ceiling does NOT offer this
        # — it's still making progress and the server auto-resumes it.
        if end_reason in ("loop_detected", "stuck"):
            emit({"type": "assistant", "message": {
                "id": f"msg_{session_id}_council", "model": model_used,
                "content": [{"type": "text", "text":
                    "I've run out of approaches I can see from here and I'm not making progress on the "
                    "objective. Rather than spin, here are your options:\n"
                    "<user-question>\n"
                    '{"question": "I appear stuck — how do you want to proceed?", "options": ['
                    '{"label": "Summon the council", "description": "Convene the 6-AI council for fresh attack vectors, then continue"}, '
                    '{"label": "Keep trying", "description": "Push on with a different approach on my own"}, '
                    '{"label": "Let me give direction", "description": "Wait for my specific instructions"}]}\n'
                    "</user-question>"}]}})

        # End-of-turn IMMEDIATE capture: if this turn did real work, distill its recent activity into the
        # ledger and auto-promote durable findings to global memory NOW — don't wait for a compaction or
        # the cron. Bounded to the recent window; promotion is deduped so nothing is written twice.
        if _AUTO_PROMOTE and _turn_tools[0] > 0:
            try:
                recent_rows = [m for m in messages[2:] if isinstance(m, dict)][-KEEP_RAW_MSGS:]
                rendered = "\n".join(
                    f"{m.get('role')}: " + (m.get('content') if isinstance(m.get('content'), str)
                        else json.dumps(m.get('content')))[:1500]
                    + (f" [tool_calls={json.dumps(m['tool_calls'])[:400]}]" if m.get('tool_calls') else "")
                    for m in recent_rows)
                if rendered.strip():
                    ledger = distill_into_ledger(rendered, ledger, args.model, headers)
                    save_ledger(args.session_file, ledger)
                    _nt = _promote_durable_to_memory(ledger, _promoted_mem, _extract_memory_sections(messages), session_id)
                    if _nt:
                        emit({"type": "assistant", "message": {
                            "id": f"msg_{session_id}_memt_{uuid.uuid4().hex[:6]}", "model": model_used,
                            "content": [{"type": "text", "text": "💾 Auto-saved to global memory: " + "; ".join(s[:90] for s in _nt[:6])}]}})
            except Exception as e:
                sys.stderr.write(f"[orchestrator] turn-end capture failed: {e}\n")

        # persist ledger one final time (it may have been updated mid-loop)
        save_ledger(args.session_file, ledger)

        result_evt = {"type": "result", "subtype": "success", "end_reason": end_reason,
                      "duration_ms": int((time.time() - start) * 1000),
                      "usage": {"input_tokens": usage_total["prompt_tokens"],
                                "output_tokens": usage_total["completion_tokens"]},
                      "model": args.model}
        if end_reason in ("safety_ceiling", "loop_detected", "stuck"):
            result_evt["max_iters"] = SAFETY_CEILING
        # Auto-resume contract with the server (operator chose "run until done/stuck"):
        #   continuable   → timed out mid-work; server transparently re-spawns "continue".
        #   offer_council → genuinely stuck; server STOPS and the council offer above is shown.
        #   (completed / question → plain stop, neither flag set.)
        result_evt["continuable"] = end_reason == "safety_ceiling"
        result_evt["offer_council"] = end_reason in ("loop_detected", "stuck")
        emit(result_evt)
    except Exception as e:
        emit({"type": "result", "subtype": "error_during_execution",
              "duration_ms": int((time.time() - start) * 1000), "is_error": True})
        emit({"type": "error", "message": str(e)})
        sys.stderr.write(f"[orchestrator] ERROR: {e}\n")
        sys.exit(1)

    # Tier 2: stash the live conversation so the next warm turn CONTINUES it (no reconstruct).
    if _WARM_ENABLED:
        _WARM_STATE = {"messages": messages, "ledger": ledger}
        _WARM_LAST_END_REASON = end_reason


if __name__ == "__main__":
    if _WARM_ENABLED:
        # Warm persistent loop — one process for the whole session (Hermes warm-agent parity).
        # After each turn: auto-continue a mid-work checkpoint (safety_ceiling) IN-PROCESS, or BLOCK
        # on stdin for the operator's next message — never exit + cold-respawn. A non-blocking stdin
        # peek lets an operator interjection preempt an auto-continue streak. EOF (server closed our
        # stdin) ends the process cleanly.
        _next = None
        _resumes = 0
        while True:
            main(_next)
            if _WARM_LAST_END_REASON == "safety_ceiling" and _resumes < _WARM_RESUME_CAP:
                _nb = _read_stdin_nonblocking()
                if _nb:
                    _next = _nb; _resumes = 0
                else:
                    _next = "continue"; _resumes += 1
            else:
                _line = sys.stdin.readline()
                if not _line:
                    break
                _next = _parse_stdin_user(_line)
                _resumes = 0
    else:
        main()
