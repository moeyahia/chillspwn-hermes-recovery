except Exception as e:  # pragma: no cover
    TOOLS_ERR = f"{type(e).__name__}: {e}"
    _OPENAI_TOOLS = []
    _TOOL_NAMES = set()

try:
    import conversation_recall as cr  # noqa: E402
except Exception:
    cr = None

# Budget-aware recall tool exposed to the model (reads the engagement conversation.mcp).
_RECALL_TOOL = {"type": "function", "function": {
    "name": "recall_conversation",
    "description": "Recall the most relevant detail for a query from ALL of your durable knowledge: the "
                   "engagement state / findings-ledger (incl. COMMANDS ALREADY RUN and their results), your "
                   "PERSISTENT MEMORY, and the full append-only conversation log. Use when you need a specific "
                   "fact, a past command/result, or any context not in your current window.",
    "parameters": {"type": "object", "properties": {
