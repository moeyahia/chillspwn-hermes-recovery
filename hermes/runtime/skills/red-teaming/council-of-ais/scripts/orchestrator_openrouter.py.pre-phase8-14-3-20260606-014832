#!/usr/bin/env python3
"""
OpenRouter Orchestrator — AGENTIC drop-in stream-json emitter for ChillsPwn.

Called by server/index.ts (spawnOpenRouter) when persona.provider === "openrouter".
Emits the EXACT JSONL event shapes the dashboard's processLines + frontend already
consume for the Claude path (system/assistant{text|tool_use}/user{tool_result}/result/error).

This version adds ChillsPwn's OWN in-session memory management so token usage and
context stay correct (operator requirement — bloat was causing wrong flags + redundant
tasks). Capabilities:

  1. FINDINGS LEDGER — a structured "what we know" state (hosts/ports/creds/vulns/
     flags/tasks) persisted per-session at <session-file>.ledger.json, injected into
     context every turn. Prevents redundant work + wrong state reads.
  2. DISTILLATION (keep-raw-until-compaction) — recent turns stay raw; older turns are
     distilled into the ledger and dropped from the MODEL context (raw transcript stays
     on disk for the user). Triggered by token budget vs the model's real context window.
  3. AUTO-CONTINUATION — the loop runs until the model NATURALLY finishes (no tool calls);
     a high configurable safety ceiling only guards against infinite loops.
  4. DSML / TEXT TOOL-CALL PARSING — some models (e.g. deepseek-v4-pro) emit tool calls
     as plain text markup (<|DSML|invoke name="terminal">...) instead of OpenAI
     tool_calls. We parse those, execute them, and CONTINUE — so the turn no longer
     "just stops" with an unexecuted call sitting in the text.
  5. TOOL-HISTORY RETENTION — on re-spawn (followup/reconnect) context is rebuilt from
     ledger + recent raw turns (incl. tool activity), not just the last 30 text lines.

Usage (unchanged contract):
  python3 orchestrator_openrouter.py --model M --prompt P --system-file S \
      --session-file J --cwd C
Environment: OPENROUTER_API_KEY (required), optional CHILLSPWN_OR_MAX_ITERS,
             CHILLSPWN_OR_CONTEXT_WINDOW.
"""

import argparse, json, os, re, sys, threading, time, uuid
from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError

OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"
MODELS_URL = "https://openrouter.ai/api/v1/models"


# ───────────────────────── Provider abstraction ─────────────────────────
# ONE agentic loop, pluggable per-LLM integration. A Provider owns ONLY the parts that differ
# between models — the endpoint + auth, how the request BODY is constructed, and how a response is
# PARSED. Everything else (the loop, tools+watchdog, memory/distillation, ledger, auto-resume,
# council, status, board) is provider-agnostic and shared. Adding a new model = a new subclass;
# amendments to the shared flow happen in exactly one place. The Claude path (`claude -p`) is a
# different integration KIND (the CLI owns its own loop) and stays separate/frozen — not here.
class Provider:
    """Base: OpenAI-style chat/completions shape. Subclasses override what differs per model."""
    name = "base"
    chat_url = ""
    models_url = ""

    def auth_headers(self) -> dict:
        raise NotImplementedError

    def build_body(self, model, messages, *, tools=None, stream=False, response_format=None,
                   max_tokens=None, temperature=None) -> dict:
        body = {"model": model, "messages": messages, "stream": stream,
                "max_tokens": max_tokens, "temperature": temperature}
        if tools:
            body["tools"] = tools
            body["tool_choice"] = "auto"
        if response_format:
            body["response_format"] = response_format
        return body

    def parse_choice(self, j) -> tuple:
        """Normalize a response → (text, tool_calls, finish_reason, model)."""
        choice = (j.get("choices") or [{}])[0]
        msg = choice.get("message") or {}
        return (msg.get("content") or "", msg.get("tool_calls") or [],
                choice.get("finish_reason"), j.get("model"))


class OpenRouterProvider(Provider):
    name = "openrouter"
    chat_url = OPENROUTER_URL
    models_url = MODELS_URL

    def auth_headers(self) -> dict:
        return {
            "Authorization": f"Bearer {os.environ.get('OPENROUTER_API_KEY', '')}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://chillspwn.local",
            "X-Title": "ChillsPwn OpenRouter",
        }

    def build_body(self, model, messages, *, tools=None, stream=False, response_format=None,
                   max_tokens=None, temperature=None) -> dict:
        body = super().build_body(model, messages, tools=tools, stream=stream,
                                  response_format=response_format, max_tokens=max_tokens,
                                  temperature=temperature)
        if tools:
            body["provider"] = {"require_parameters": True}   # OpenRouter-specific routing
        return body


def make_provider(args=None) -> Provider:
    """Select the provider from --provider (default openrouter). openai-codex loads the
    self-contained CodexProvider (Responses API via the Hermes rails); anything else = OpenRouter,
    so the existing behavior is unchanged."""
    prov = getattr(args, "provider", None) or "openrouter"
    if prov == "openai-codex":
        import provider_codex
        return provider_codex.CodexProvider(model=getattr(args, "model", None))
    return OpenRouterProvider()


PROVIDER = make_provider()   # module-level singleton; reassigned in main() once args are parsed

# AUTONOMOUS continuation (matches Hermes' gateway auto-continue, config.yaml
# gateway_auto_continue_freshness: 3600). The agent keeps working on its OWN — the operator
# does NOT re-send "continue". It runs until it genuinely finishes (a real final answer / a
# question only the user can answer), a loop is detected, OR it has been working autonomously
# for AUTO_CONTINUE_SECONDS — only THEN does it post a resumable checkpoint summary. The old
# behaviour (pause at ~90 iterations and wait for the user) is gone.
#   • SAFETY_CEILING        — high raw-iteration runaway backstop (rarely hit before the timer)
#   • AUTO_CONTINUE_SECONDS — wall-clock autonomous window before a checkpoint (Hermes = 3600s)
#   • COMPACT_EVERY         — force context compaction + a progress note every N iterations
try:
    SAFETY_CEILING = max(1, min(int(os.environ.get("CHILLSPWN_OR_MAX_ITERS", "2000")), 100000))
except (TypeError, ValueError):
    SAFETY_CEILING = 2000
try:
    AUTO_CONTINUE_SECONDS = max(60, int(os.environ.get("CHILLSPWN_OR_AUTO_CONTINUE_SECONDS", "3600")))
except (TypeError, ValueError):
    AUTO_CONTINUE_SECONDS = 3600
COMPACT_EVERY = 80

MAX_TOKENS = 16000          # per-response cap
HTTP_TIMEOUT = 300
# Token streaming (Hermes-parity "alive feel"): stream the model response over SSE and emit
# live stream_event deltas the dashboard already renders (processLines → claude_delta). The
# consolidated assistant/result events below stay the source of truth (transcript/usage
# unchanged), exactly like the claude path. Toggle off with CHILLSPWN_OR_STREAM=0.
STREAM_TOKENS = os.environ.get("CHILLSPWN_OR_STREAM", "1") != "0"
# When streaming a DeepSeek turn, the tool call arrives as visible TEXT (DSML markup). Stop
# forwarding text deltas once a tool-call open marker appears so raw markup doesn't flash in
# the UI; the cleaned consolidated text + tool card replace it. (Pre-marker reasoning streams.)
_STREAM_TOOL_MARKERS = ("<｜DSML｜", "<|DSML|", "<invoke ", "<invoke>")
_STREAM_HOLDBACK = max(len(m) for m in _STREAM_TOOL_MARKERS) - 1  # never emit a possible marker prefix
TOOL_RESULT_CAP = 24000     # cap a single raw tool result fed to the model
KEEP_RAW_MSGS = 28          # most-recent conversation turns kept verbatim (Hermes protect_last_n≈20)
PROTECT_FIRST_MSGS = 3      # also keep the OPENING turns verbatim (objective / target / mode) on compaction
COMPACT_AT = 0.60           # compact when est. tokens exceed this fraction of the window
DEFAULT_WINDOW = 128000
DISTILL_INPUT_CAP = 48000   # max chars of old turns fed to ONE distillation call
# render_ledger injection caps. The ledger is injected IN FULL on every turn, and distillation
# appends to actions/tasks_done/key_facts monotonically — so without a ceiling the rendered ledger
# grows unbounded, comes to dominate the context budget, and triggers a runaway compaction loop
# (distilling MORE into the ledger never shrinks it). Cap the high-volume lists to their MOST RECENT
# items; the full lists stay on disk and remain reachable via recall_conversation. Env-tunable.
LEDGER_CAP_ACTIONS    = int(os.environ.get("CHILLSPWN_OR_LEDGER_CAP_ACTIONS", "40"))
LEDGER_CAP_TASKS_DONE = int(os.environ.get("CHILLSPWN_OR_LEDGER_CAP_TASKS_DONE", "60"))
LEDGER_CAP_TASKS_PEND = int(os.environ.get("CHILLSPWN_OR_LEDGER_CAP_TASKS_PEND", "40"))
LEDGER_CAP_KEY_FACTS  = int(os.environ.get("CHILLSPWN_OR_LEDGER_CAP_KEY_FACTS", "80"))
DISTILL_CHUNK_CHARS = 40000        # page size for chunked backlog distillation (< DISTILL_INPUT_CAP)
DISTILL_MAX_CHUNKS_PER_RUN = 16    # runaway guard: max distill calls per reconstruct/compact pass

# ── Hermes-parity continuation discipline (ported from agent/conversation_loop.py) ──
# Hermes keeps ONE loop alive and drives the model forward: when a weaker model narrates
# intent ("let me verify…") or asks permission ("want me to continue?") but emits no tool
# call, Hermes injects a user nudge and CONTINUES rather than ending the turn. We port that
# as a per-turn budget of continuation nudges (vs the old single one-shot nudge). The turn
# still ends on a genuine completion, a real blocking question, the loop-detector, or the
# safety ceiling. CONTINUE_BUDGET caps narration-recoveries so a model that ignores nudges
# can't burn the whole safety ceiling on no-op chatter.
CONTINUE_BUDGET = 12               # max Path-C continuation nudges per turn (intent/permission)
MAX_LENGTH_CONTINUATIONS = 3       # Hermes-style: continue a response truncated by max_tokens
NUDGE_STALL_LIMIT = 2              # if a nudge yields ~identical no-tool text N times, give up
# SELF-RECOVERY: hard wall-clock timeout on a single external tool call. ct.dispatch is the one
# unbounded blocking path (the model API, distillation, board_await, delegate_task all self-bound),
# and a tool that ignores its own timeout — e.g. process(action=wait) on a never-exiting background
# server — froze a whole turn for 20min (the 09:26 hang). Past this, we ABANDON the call and continue.
try:
    TOOL_HARD_TIMEOUT = max(20, int(os.environ.get("CHILLSPWN_OR_TOOL_TIMEOUT", "180")))
except (TypeError, ValueError):
    TOOL_HARD_TIMEOUT = 180

LEDGER_KEYS = ("hosts", "credentials", "vulns", "flags",
               "tasks_done", "tasks_pending", "key_facts", "actions")

# ── Tier 2: warm persistent process (opt-in via CHILLSPWN_OR_WARM=1) ──
# When enabled the orchestrator process STAYS ALIVE across turns (Hermes warm-agent parity): it
# keeps the conversation in memory and reads the next operator message from stdin instead of
# exiting + being cold-respawned (the one-shot model that forced a reconstruct every message and
# made it feel automated). Default OFF → the proven one-shot path is byte-for-byte unchanged.
_WARM_ENABLED = (os.environ.get("CHILLSPWN_OR_WARM") or "0").strip().lower() in ("1", "true", "yes", "on")
_WARM_RESUME_CAP = int(os.environ.get("CHILLSPWN_OR_WARM_RESUME_CAP", "6"))
_WARM_STATE = None              # {"messages":[...], "ledger":{...}} carried across warm turns
_WARM_LAST_END_REASON = "final"

def _parse_stdin_user(line):
    """Extract the user text from a server-written stdin line. writeUserToStdin sends
    {"type":"user","message":{"role":"user","content":[{"type":"text","text":...}]}}; fall back to
    the raw line for a plain string (e.g. the auto-resume 'continue')."""
    line = (line or "").strip()
    if not line:
        return ""
    try:
        obj = json.loads(line)
        c = (obj.get("message") or {}).get("content")
        if isinstance(c, list):
            return " ".join(b.get("text", "") for b in c
                            if isinstance(b, dict) and b.get("type") == "text").strip() or line
        if isinstance(c, str):
            return c
    except Exception:
        pass
    return line

def _read_stdin_nonblocking():
    """Return a pending operator message from stdin without blocking (lets an operator interjection
    preempt an auto-continue streak), else None."""
    import select
    try:
        r, _, _ = select.select([sys.stdin], [], [], 0)
        if r:
            ln = sys.stdin.readline()
            if ln:
                return _parse_stdin_user(ln)
    except Exception:
        pass
    return None

