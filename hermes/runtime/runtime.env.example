# Hermes/ChillsPwn runtime locations. Copy required values into the protected
# service environment; do not load this example file in production.
HERMES_HOME=/root/.hermes
HERMES_KANBAN_DB=/root/.hermes/kanban.db
HERMES_PYTHON=/root/hermes-venv/bin/python
CHILLSPWN_HERMES_SRC=/opt/chillspwn/hermes-agent
CHILLSPWN_PLUGIN_DIR=/opt/chillspwn/plugin
CHILLSPWN_STATE_DIR=/root/.hermes/chillspwn
CHILLSPWN_SESSIONS_DIR=/root/.hermes/chillspwn/sessions
CHILLSPWN_PERSONAS_DIR=/root/.hermes/chillspwn/personas
GROK_BIN=/opt/chillspwn/bin/grok
GROK_HOME=/root/.hermes/chillspwn/grok
GROK_AUTH_PATH=/root/.hermes/auth/grok/auth.json
CHILLSPWN_MEMORY_GUARD=required
CHILLSPWN_MEM_CLI=/root/.hermes/skills/red-teaming/council-of-ais/scripts/chillspwn_mem.py
CHILLSPWN_MEMORY_SOCKET=/run/chillspwn-memory/broker.sock
MCP_ARSENAL_CONFIG=/opt/chillspwn-mcp-arsenal/.mcp.arsenal.json
MCP_ARSENAL_RUNTIME_DIR=/root/.hermes/chillspwn/mcp-runtime
CLAUDE_CONFIG_DIR=/root/.hermes/auth/claude
CODEX_HOME=/root/.hermes/auth/codex

# Optional stronger Council OAuth separation. Each path must be a fully
# provisioned Hermes home with the shared non-secret config/SOUL/skills and only
# that provider's authenticated state. Leave unset to use HERMES_HOME.
# COUNCIL_CODEX_HERMES_HOME=/root/.hermes/profiles/council-codex
# COUNCIL_XAI_HERMES_HOME=/root/.hermes/profiles/council-xai

# Root-launched Claude subscription lane. The account must be a dedicated
# non-root service account with its own authenticated CLI state.
COUNCIL_CLAUDE_USER=chillspwn
COUNCIL_CLAUDE_HOME=/root

# Resource-alert state and non-sensitive routing label.
HERMES_RESOURCE_ALERT_STATE_PATH=/root/.hermes/state/server-resource-alert.json
HERMES_RESOURCE_ALERT_HOST_LABEL=assessment-node

# WiFi Pineapple deployment. The host and MAC values below are documentation
# examples only; replace them in the private environment after verification.
PINEAPPLE_SSH_TARGET=operator@pineapple.example
PINEAPPLE_SSH_KEY=/etc/chillspwn/keys/pineapple_ed25519
PINEAPPLE_API_BASE=http://192.0.2.10:1471
PINEAPPLE_PROTECTED_SSID=EXAMPLE-AUTHORIZED-SSID
PINEAPPLE_EXPECTED_UPLINK_SSID=EXAMPLE-AUTHORIZED-SSID
PINEAPPLE_KNOWN_BSSIDS_FILE=/etc/chillspwn/pineapple/known-bssids.txt
PINEAPPLE_NEARBY_AP_ALLOWLIST_FILE=/etc/chillspwn/pineapple/nearby-ap-allowlist.txt
PINEAPPLE_IGNORED_SSIDS_FILE=/etc/chillspwn/pineapple/ignored-ssids.txt
PINEAPPLE_HANDSHAKE_DIR=/var/lib/pineapple/handshakes
PINEAPPLE_STATE_FILE=/var/lib/chillspwn/pineapple/monitor.state
PINEAPPLE_HEALTH_HOST=192.0.2.10
PINEAPPLE_CONTROL_MAC=00:00:5e:00:53:01
PINEAPPLE_MONITOR_SCRIPT=/root/.hermes/skills/wireless/pineapple/scripts/pineapple-monitor.sh
PINEAPPLE_DEFENSE_SCRIPT=/root/.hermes/skills/wireless/pineapple/scripts/network-defense.sh
PERIMETER_MONITOR_SCRIPT=/usr/local/libexec/chillspwn/perimeter-monitor
PERIMETER_DAILY_SCRIPT=/usr/local/libexec/chillspwn/perimeter-daily-summary

# Optional remote GPU worker. All values are required by gpu-crack when used.
WINHOST=operator@gpu-worker.example
WINHOST_KEY=/etc/chillspwn/keys/gpu_worker_ed25519
WINHC_DIR=D:\\Tools\\hashcat

# Provider secrets belong only in the protected environment. Leave blank here.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
