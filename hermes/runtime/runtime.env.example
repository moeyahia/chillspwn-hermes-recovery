# Hermes/ChillsPwn runtime locations. Copy only required values into the
# root-owned mode-0600 service EnvironmentFile. This file contains no secrets.
HOME=/home/chillspwn
HERMES_HOME=/var/lib/chillspwn/hermes
HERMES_KANBAN_DB=/var/lib/chillspwn/hermes/kanban.db
HERMES_PYTHON=/opt/chillspwn-runtime/hermes-venv/bin/python
CHILLSPWN_HERMES_SRC=/opt/chillspwn/hermes-agent
CHILLSPWN_PLUGIN_DIR=/opt/chillspwn/plugin
CHILLSPWN_REPORT_TEMPLATE_DIR=/opt/chillspwn/report-template
CHILLSPWN_STATE_DIR=/var/lib/chillspwn/state
CHILLSPWN_SESSIONS_DIR=/var/lib/chillspwn/state/sessions
CHILLSPWN_PERSONAS_DIR=/opt/chillspwn/plugin/webapp/server/agents/personas
COMMAND_OS_DB_PATH=/var/lib/chillspwn/command-os-v2.sqlite
CHILLSPWN_VAULT_ROOT=/var/lib/chillspwn/brain-vaults
CHILLSPWN_BUN_BIN=/opt/chillspwn-runtime/bin/bun
GROK_COMMANDER_BUN=/opt/chillspwn-runtime/bin/bun
GROK_BIN=/opt/chillspwn/bin/grok
GROK_HOME=/var/lib/chillspwn/grok-home
GROK_AUTH_PATH=/var/lib/chillspwn/grok-auth/auth.json
MCP_ARSENAL_CONFIG=/opt/chillspwn-mcp-arsenal/.mcp.arsenal.json
MCP_ARSENAL_RUNTIME_DIR=/var/lib/chillspwn/state/mcp-runtime
MCP_ARSENAL_ALLOW_DOCKER=false
CLAUDE_CONFIG_DIR=/var/lib/chillspwn/claude
CODEX_HOME=/var/lib/chillspwn/codex
ALLOWED_WORKSPACE_ROOTS=/var/lib/chillspwn/workspaces/htb/boxes,/var/lib/chillspwn/workspaces/engagements

# Command OS V2 memory is canonical in COMMAND_OS_DB_PATH and projected to
# CHILLSPWN_VAULT_ROOT. Do not set the legacy root memory-broker variables.

# Optional stronger Council OAuth separation. Each path must be a fully
# provisioned service-owned Hermes home containing only that provider's state.
# COUNCIL_CODEX_HERMES_HOME=/var/lib/chillspwn/hermes/profiles/council-codex
# COUNCIL_XAI_HERMES_HOME=/var/lib/chillspwn/hermes/profiles/council-xai

COUNCIL_CLAUDE_USER=chillspwn
COUNCIL_CLAUDE_HOME=/home/chillspwn

# Resource-alert state and non-sensitive routing label.
HERMES_RESOURCE_ALERT_STATE_PATH=/var/lib/chillspwn/hermes/state/server-resource-alert.json
HERMES_RESOURCE_ALERT_HOST_LABEL=assessment-node

# WiFi Pineapple documentation placeholders. Replace only in the protected
# environment after verifying an authorized engagement.
PINEAPPLE_SSH_TARGET=operator@pineapple.example
PINEAPPLE_SSH_KEY=/etc/chillspwn/keys/pineapple_ed25519
PINEAPPLE_API_BASE=http://192.0.2.10:1471
PINEAPPLE_PROTECTED_SSID=EXAMPLE-AUTHORIZED-SSID
PINEAPPLE_EXPECTED_UPLINK_SSID=EXAMPLE-AUTHORIZED-SSID
PINEAPPLE_KNOWN_BSSIDS_FILE=/etc/chillspwn/pineapple/known-bssids.txt
PINEAPPLE_NEARBY_AP_ALLOWLIST_FILE=/etc/chillspwn/pineapple/nearby-ap-allowlist.txt
PINEAPPLE_IGNORED_SSIDS_FILE=/etc/chillspwn/pineapple/ignored-ssids.txt
PINEAPPLE_HANDSHAKE_DIR=/var/lib/pineapple/handshakes
PINEAPPLE_STATE_FILE=/var/lib/chillspwn/pineapple/monitor.state
PINEAPPLE_HEALTH_HOST=192.0.2.10
PINEAPPLE_CONTROL_MAC=00:00:5e:00:53:01
PINEAPPLE_MONITOR_SCRIPT=/var/lib/chillspwn/hermes/skills/wireless/pineapple/scripts/pineapple-monitor.sh
PINEAPPLE_DEFENSE_SCRIPT=/var/lib/chillspwn/hermes/skills/wireless/pineapple/scripts/network-defense.sh
PERIMETER_MONITOR_SCRIPT=/usr/local/libexec/chillspwn/perimeter-monitor
PERIMETER_DAILY_SCRIPT=/usr/local/libexec/chillspwn/perimeter-daily-summary

# Optional remote GPU worker. All values are required by gpu-crack when used.
WINHOST=operator@gpu-worker.example
WINHOST_KEY=/etc/chillspwn/keys/gpu_worker_ed25519
WINHC_DIR=D:\\Tools\\hashcat

# Provider secrets belong only in the protected environment. Leave blank here.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
