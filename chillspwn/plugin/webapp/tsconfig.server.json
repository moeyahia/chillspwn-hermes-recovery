{
  "//": "Strict typecheck for modular server code. The legacy server/index.ts is intentionally",
  "//2": "excluded until its existing diagnostics are resolved. Tests use bun:test and are",
  "//3": "validated by `bun test`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "bun"],
    "lib": ["ES2022"]
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "server/index.ts", "**/__tests__/**", "**/*.test.ts"]
}
