# ──────────────────────────────────────────────────────────────────────────
# ChillsPwn dashboard — example environment (security + runtime)
# Copy to `.env` only for local Bun development. In production, place settings
# in the root-owned mode-0600 EnvironmentFile loaded by systemd before User=
# is applied. The unprivileged server must not read secret files. NEVER commit
# a real .env.
#
# Secure defaults: with NO env set, the dashboard binds 127.0.0.1 (local only),
# requires no token (loopback is trusted), and every risky feature is OFF.
# ──────────────────────────────────────────────────────────────────────────

# ── Network exposure ────────────────────────────────────────────────────────
# Address the HTTP+WS server binds to. Default: 127.0.0.1 (loopback / local only).
# Set to 0.0.0.0 or your Tailscale IP to expose the dashboard. If you expose it,
# DASHBOARD_TOKEN becomes REQUIRED (the server fails closed otherwise).
#CHILLSPWN_BIND=127.0.0.1
#CHILLSPWN_PORT=3131

# Shared-secret token gating HTTP + WebSocket when exposed (or whenever it is set).
# Loopback clients are always trusted and never need it. Generate a strong value:
#   openssl rand -hex 32
#DASHBOARD_TOKEN=

# Escape hatch: start EXPOSED with NO auth. Dangerous — anyone who can reach the
# port gets full control. Only for throwaway/lab use. Default false.
#CHILLSPWN_ALLOW_UNSAFE_NO_AUTH=false

# ── Risky-feature gates (secure default = off; enable what you use) ──────────
# Interactive shell over the WebSocket terminal.
#ENABLE_TERMINAL=false
# Outbound /proxy/anthropic passthrough (only needed if you point ANTHROPIC_BASE_URL here).
#ENABLE_PROXY=false
# Arbitrary-path file writes via PUT /api/files/write.
#ENABLE_FILE_WRITE=false
# Offensive/pentest tooling through terminal-class tools (nmap, impacket, hashcat, …).
#ENABLE_SECURITY_TOOLS=false

# ── Approval gates (enforced for runtime-owned managed tool calls) ──────────
#REQUIRE_APPROVAL_FOR_TERMINAL=true
#REQUIRE_APPROVAL_FOR_FILE_WRITE=true

# ── Chat ↔ Agent-Runtime integration (default OFF) ──────────────────────────
# When ON, a normal chat turn ALSO creates an OBSERVE-ONLY AgentRun visible in the
# Agent Cockpit: it records provider turns + classifies observed tool calls (showing
# the policy decision that WOULD apply), but it NEVER blocks, gates, or alters chat,
# and NEVER touches claude -p / spawnClaude / the orchestrator. Observed live-chat
# tool calls are labeled observe-only / not enforced (enforcement is real only for
# runtime-owned /api/runs). When OFF, chat is byte-for-byte unchanged.
#ENABLE_CHAT_AGENT_RUNS=false
#CHAT_AGENT_MODE=observe          # observe | managed
# CHAT_AGENT_PLANNING=preview enables the cockpit's "Generate plan preview" button:
# a MANUAL, advisory, NON-ENFORCED plan for an observe-only chat run. "off" = no preview.
#CHAT_AGENT_PLANNING=off          # off | preview | inferred
#CHAT_AGENT_PLANNING_MODEL=z-ai/glm-5.1   # OpenRouter slug used for the advisory preview / managed plan call
#CHAT_AGENT_FORCE_PLAN=false      # force plan-first behavior only when explicitly enabled
# Optional runtime-managed chat launcher. When ON, the cockpit can create a
# managed AgentRun with strict planning and the configured approval/execution path.
#ENABLE_RUNTIME_MANAGED_CHAT=false
#REQUIRE_PLAN_APPROVAL=true        # managed runs hold at awaiting_plan_approval until approved

# ── Provider authentication and local CLI state ─────────────────────────────
# OpenRouter-backed personas require an API key. Leave blank to disable them.
#OPENROUTER_API_KEY=

# Gemini's current direct-API path is executed by the external Hermes Python
# orchestrator, which reads this key from the service environment.
#GEMINI_API_KEY=

# Grok ACP uses the installed Grok CLI's OAuth session, not an xAI API key.
# The application resolves auth.json without reading or copying it. Keep the
# credential outside this repository and restrict it to the service account.
#GROK_BIN=/opt/chillspwn/bin/grok
#GROK_HOME=/root/.hermes/chillspwn/grok
#GROK_AUTH_PATH=/root/.hermes/auth/grok/auth.json

# Integrated recovery state/auth roots. Local development may omit these and use
# HOME-derived defaults; production systemd sets them explicitly.
#HERMES_HOME=/root/.hermes
#HERMES_PYTHON=/root/hermes-venv/bin/python
#CHILLSPWN_HERMES_SRC=/opt/chillspwn/hermes-agent
#CHILLSPWN_PLUGIN_DIR=/opt/chillspwn/plugin
#CHILLSPWN_STATE_DIR=/root/.hermes/chillspwn
#CHILLSPWN_SESSIONS_DIR=/root/.hermes/chillspwn/sessions
#CHILLSPWN_PERSONAS_DIR=/root/.hermes/chillspwn/personas
#CLAUDE_CONFIG_DIR=/root/.hermes/auth/claude
#CODEX_HOME=/root/.hermes/auth/codex

# Reusable memory is root-only in production. The dashboard/gateway must use the
# validated broker and must not be granted direct access to $HERMES_HOME/memories.
#CHILLSPWN_MEMORY_GUARD=required
#CHILLSPWN_MEM_CLI=/root/.hermes/skills/red-teaming/council-of-ais/scripts/chillspwn_mem.py
#CHILLSPWN_MEMORY_SOCKET=/run/chillspwn-memory/broker.sock

# ── Runtime enforcement and lifecycle ───────────────────────────────────────
#ENABLE_OPENROUTER_RUNTIME_GATING=false
#OPENROUTER_GATE_MODE=off          # off | dry-run | enforce
#OPENROUTER_GATE_FAIL_MODE=deny    # only supported fail mode
#OPENROUTER_GATE_TIMEOUT_SECONDS=300
#OPENROUTER_GATE_POLL_SECONDS=2

# Additive runtime features. These defaults record/report state; risky execution
# remains controlled by the gates above.
#ENABLE_DELEGATED_WORKER_CONTRACT=true
#ENABLE_LIVE_MEMORY_PROPOSALS=true
#ENABLE_FINAL_RUN_REPORTS=true
#ENABLE_ARTIFACT_STORAGE=true
#ENABLE_COCKPIT_LIVE_REFRESH=true
#ENABLE_TRAINING_MEMORY=true
#ENABLE_LEGACY_PROMPT_CLEANUP=false
#ENABLE_SESSION_AUTO_ARCHIVE=true

# Commander/specialist routing. ENFORCE_CHILLSPWN_NO_HANDS defaults true.
#ENABLE_SPECIALIST_AGENT_ROUTING=true
#ENFORCE_CHILLSPWN_DELEGATION=false
#ALLOW_CHILLSPWN_DIRECT_TOOLS=false
#REQUIRE_SPECIALIST_ASSIGNMENT=false
#ENFORCE_CHILLSPWN_NO_HANDS=true

# ── MCP Arsenal bridge ───────────────────────────────────────────────────────
# Start in dry-run and review the allowlisted tools before enabling execution.
#ENABLE_MCP_ARSENAL=false
#MCP_ARSENAL_CONFIG=/opt/chillspwn-mcp-arsenal/.mcp.arsenal.json
#MCP_ARSENAL_RUNTIME_DIR=/root/.hermes/chillspwn/mcp-runtime
#MCP_ARSENAL_MODE=disabled         # disabled | dry-run | enabled
#MCP_ARSENAL_START_SERVERS=false
#MCP_ARSENAL_ALLOW_DOCKER=false
#MCP_ARSENAL_DEFAULT_TIMEOUT_SECONDS=120
#MCP_ARSENAL_MAX_OUTPUT_BYTES=20000

# ── Approval policy ──────────────────────────────────────────────────────────
#APPROVAL_MODE=human               # human | auto | hybrid
#AUTO_APPROVE_RISK_CLASSES=read-only,network
#AUTO_APPROVE_TOOL_NAMES=
#AUTO_APPROVE_AGENT_IDS=
#AUTO_APPROVE_MAX_RISK=network

# ── Filesystem scoping ──────────────────────────────────────────────────────
# Colon- or comma-separated absolute roots used by the file browser, engagement
# APIs, Claude --add-dir arguments, engagement working-directory resolution, and
# OSINT output placement. Defaults: /root/htb/boxes and /root/engagements.
# The recovery helper creates and grants only those two defaults. Any custom root
# must already be a real, non-symlink directory writable/traversable by chillspwn.
#ALLOWED_WORKSPACE_ROOTS=/root/htb/boxes:/root/engagements

# ── Legacy / unsafe (default off; scheduled for removal) ─────────────────────
# Enables g0dm0d3/parseltongue leetspeak prompt rewriting. Non-auditable; do NOT
# enable in normal operation. Leaving this off keeps the runtime transparent.
#ENABLE_PROMPT_OBFUSCATION=false

# ── Optional Capacitor live-reload build settings ───────────────────────────
# Omit these for packaged builds. Never commit a private deployment hostname.
#CAPACITOR_SERVER_URL=https://dashboard.example.invalid
#CAPACITOR_ALLOW_MIXED_CONTENT=false

# Optional MCP vendor API-key names are documented in `.env.mcp.example`.

# ──────────────────────────────────────────────────────────────────────────
# Access-mode recipes
# ──────────────────────────────────────────────────────────────────────────
# Local-only (default):           (unset everything)
# SSH tunnel:                      CHILLSPWN_BIND=127.0.0.1   # then: ssh -L 3131:127.0.0.1:3131 host
# Tailscale + token:               CHILLSPWN_BIND=<tailscale-ip>   DASHBOARD_TOKEN=<hex>
# 0.0.0.0 + token (preserve current reach):  CHILLSPWN_BIND=0.0.0.0   DASHBOARD_TOKEN=<hex>
#   Then open the dashboard once as  https://<host>:3131/?token=<hex>  to set the cookie.
