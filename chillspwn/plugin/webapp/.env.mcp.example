# ChillsPwn MCP / asset API keys — PLACEHOLDERS ONLY. Copy needed lines into the
# protected service EnvironmentFile (never committed). Values are read from env only.
# Leave blank to keep the corresponding MCP DISABLED. Do NOT set per-engagement values globally.

# ── VulnIntel / CVE intelligence (OPTIONAL — keyless NVD/EPSS/KEV already works) ──
NVD_API_KEY=                 # optional — raises NVD rate limit (free key at nvd.nist.gov)
# CVE_SEARCH_BASE=           # only if self-hosting a local cve-search instance (URL)

# ── OSINT / threat intelligence (OPTIONAL — keep disabled until provided) ──
VIRUSTOTAL_KEY=              # alias: VIRUSTOTAL_API_KEY / VT_API_KEY
SHODAN_KEY=                  # alias: SHODAN_API_KEY
OTX_API_KEY=
GREYNOISE_API_KEY=
# ZOOMEYE_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# ── Cloud-ACCOUNT posture ONLY (NOT needed for cloud-hosted TARGET testing) ──
# AWS_PROFILE=               # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (read-only, your account)
# KUBECONFIG=
# AZURE_TENANT_ID=  AZURE_CLIENT_ID=  AZURE_CLIENT_SECRET=  AZURE_SUBSCRIPTION_ID=
# GOOGLE_APPLICATION_CREDENTIALS=  GOOGLE_CLOUD_PROJECT=

# ── AD per-engagement (set ONLY for the active authorized lab, never globally) ──
# AD_DC_HOST=
# AD_DOMAIN=

# ── SSH / session per-engagement (set ONLY for the active authorized lab) ──
# PENTEST_SSH_TARGETS=
# TARGET_PASSWORD=           # or TARGET_SSH_KEY
