{
  "name": "chillspwn-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "overrides": {
    "tar": "^7.5.20"
  },
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "server": "bun run server/index.ts",
    "client": "vite",
    "build": "vite build",
    "serve": "bun run server/index.ts",
    "preview": "vite preview",
    "check:server-entry": "bun build server/index.ts --target=bun --packages=external --outfile=/tmp/chillspwn-server-entry-check.js",
    "typecheck": "tsc -p tsconfig.server.json",
    "typecheck:client": "tsc -p tsconfig.json",
    "test": "bun test ./server ./src/lib",
    "test:gate": "python3 integration/test_or_gate_client.py",
    "check": "bun run check:server-entry && bun run typecheck && bun run typecheck:client && bun test ./server ./src/lib && python3 integration/test_or_gate_client.py && python3 integration/test_board_mcp_server.py && bun run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.14",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
