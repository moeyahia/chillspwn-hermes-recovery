{
  "name": "chillspwn-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "overrides": {
    "tar": "^7.5.20"
  },
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "server": "bun run server/index.ts",
    "client": "vite",
    "build": "vite build",
    "serve": "bun run server/index.ts",
    "preview": "vite preview",
    "check:server-entry": "bun build server/index.ts --target=bun --packages=external --outfile=/tmp/chillspwn-server-entry-check.js",
    "typecheck": "tsc -p tsconfig.server.json",
    "typecheck:client": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "bun test ./server ./src/lib",
    "test:e2e": "bun run build && bun run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:brain-scale": "bun run build && CHILLSPWN_E2E_BRAIN_SCALE_PROFILE=1 playwright test tests/e2e/second-brain-scale.spec.ts --project=second-brain-scale",
    "test:e2e:observability-scale": "bun run build && CHILLSPWN_E2E_OBSERVABILITY_SCALE_PROFILE=1 playwright test tests/e2e/observability-scale.spec.ts --project=observability-scale",
    "test:e2e:headed": "bun run build && playwright test --headed",
    "e2e:server": "bun run tests/e2e/support/start-server.ts",
    "performance:bundle": "bun run scripts/command-os-v2/measure-bundle.ts",
    "performance:runtime": "bun run scripts/command-os-v2/measure-canonical-runtime.ts",
    "performance:missions": "bun run scripts/command-os-v2/measure-mission-benchmarks.ts",
    "performance:check": "bun run build && bun run performance:bundle && bun run performance:runtime && bun run performance:missions && COMMAND_OS_ENFORCE_BROWSER_BUDGETS=true playwright test tests/e2e/performance-accessibility.spec.ts",
    "mobile:sync:android": "bun run build && bunx cap sync android",
    "mobile:doctor:android": "bunx cap doctor android",
    "mobile:build:android": "bun run mobile:sync:android && bash scripts/command-os-v2/build-android.sh",
    "test:live:grok-oauth": "bun run scripts/command-os-v2/live-grok-oauth-smoke.ts",
    "test:live:grok-restart-resume": "bun run scripts/command-os-v2/live-grok-restart-resume-smoke.ts",
    "test:acceptance:obsidian": "bun run scripts/command-os-v2/obsidian-bridge-acceptance-smoke.ts",
    "test:acceptance:obsidian-scale": "bun run scripts/command-os-v2/obsidian-vault-scale-profile.ts",
    "test:rehearsal:schema9": "bash scripts/command-os-v2/rehearse-schema9-guided-boundary.sh",
    "test:rehearsal:schema9:safety": "bash scripts/command-os-v2/test-schema9-rehearsal-safety.sh",
    "test:rehearsal:schema7-to-schema9": "SCHEMA8_REHEARSAL_CONFIRM=isolated-schema8-bridge-rehearsal bash scripts/command-os-v2/rehearse-schema8-bridge.sh",
    "test:rehearsal:schema7-to-schema9:safety": "bash scripts/command-os-v2/test-schema8-rehearsal-safety.sh",
    "test:gate": "python3 integration/test_or_gate_client.py",
    "db:migrate:legacy": "bun run server/migration/cli.ts migrate",
    "db:migrate": "bun run server/db/cli.ts migrate",
    "db:verify": "bun run server/migration/cli.ts verify",
    "db:backup": "bun run server/migration/cli.ts backup",
    "db:reconcile": "bun run server/migration/cli.ts reconcile",
    "db:restore": "bun run server/migration/cli.ts restore",
    "brain:import-obsidian": "bun run server/vault/cli.ts import",
    "brain:export-obsidian": "bun run server/vault/cli.ts export",
    "brain:project-legacy": "bun run server/migration/cli.ts project-vault",
    "brain:sync-verify": "bun run server/vault/cli.ts sync-verify",
    "check": "bun run check:server-entry && bun run typecheck && bun run typecheck:client && bun run typecheck:e2e && bun test ./server ./src/lib && python3 integration/test_or_gate_client.py && python3 integration/test_board_mcp_server.py && bun run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/bun": "^1.3.14",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
