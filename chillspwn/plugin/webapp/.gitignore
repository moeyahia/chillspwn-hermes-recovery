# ──────────────────────────────────────────────────────────────────────────
# ChillsPwn webapp .gitignore
# Goal: track ONLY source. Never commit secrets, CTF loot, auth material,
# logs, build outputs, caches, backups, archives, or generated artifacts.
# Keep source and intentionally sanitized examples only. Runtime and engagement
# data belong outside the repository, even when Git would otherwise accept them.
# ──────────────────────────────────────────────────────────────────────────

# ── Dependencies / build outputs ──
node_modules/
dist/
dist-revamp/
dist-*/
build/
coverage/
htmlcov/
.vite/
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/
android/capacitor-cordova-android-plugins/build/
*.tsbuildinfo

# ── Logs & runtime data ──
logs/
*.log
*.out
.runtime-phase*-bak/
runtime-data/
server/runtime/.data/

# ── Backups / snapshots / archives ──
# NB: *.bak* (not *.bak.*) so timestamped copies like `index.ts.bak-20260531` are caught too.
*.bak
*.bak*
*.orig
*.tmp
*.tmp-*
*~
archives/
*.zip
*.tar
*.tar.gz
*.tgz
chillspwn-agent-runtime-phase-*.zip

# ── Secrets / auth / tokens (NEVER COMMIT) ──
.env
.env.*
!.env.example
!.env.*.example
auth.json
**/auth.json
*.token
*.secret
.secrets/
secrets.local.*
*.credentials.json
.credentials.json

# ── Cryptographic / engagement credential material ──
*.ccache
*.kirbi
*.keytab
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.pcap
*.pcapng

# ── CTF loot / engagement artifacts (this tree currently holds live loot) ──
loot/
flags/
flag*.txt
*flag*.txt
C:\\*
*.accdb
*.mdb
CVE-*.py
[0-9][0-9][0-9][0-9][0-9].py
[0-9][0-9][0-9][0-9][0-9].sh
[0-9][0-9][0-9][0-9][0-9].txt
/[0-9][0-9][0-9][0-9][0-9].php
dacledit-*.bak
/scans/
/ferox-*.state
/ligolo-ng.history
/ligolo-ng.yaml
/ligolo-selfcerts/
/out_success.txt
/nimbus_writeup.md
/)*

# ── Generated / local databases & conversation logs ──
conversation.mcp
*.mcp
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# ── Caches & runtime state ── (bun.lock is tracked source)
.cache/
*.cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.tmp/
tmp/
*.pid
.last-*

# ── More credential/engagement material ──
*.ovpn
*.rdp
*.kdbx
*.gpg

# ── Capacitor / mobile build noise ──
capacitor.config.json
.gradle/
*.apk
*.aab
*.keystore

# ── OS / editor noise ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
__pycache__/
*.pyc
