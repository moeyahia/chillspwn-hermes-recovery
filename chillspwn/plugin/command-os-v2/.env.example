# Command OS V2 uses its own environment namespace. Never reuse legacy browser keys.
COMMAND_OS_V2_BIND=127.0.0.1
COMMAND_OS_V2_PORT=43141
COMMAND_OS_V2_DATABASE_PATH=./data/command-os-v2.sqlite
COMMAND_OS_V2_ARTIFACT_ROOT=./data/artifacts
COMMAND_OS_V2_KILL_SWITCH=false
COMMAND_OS_V2_PREVIEW=true
COMMAND_OS_V2_SERVE_STATIC=true
# Optional immutable preview/release handoff root. When configured, the server
# verifies and pins active.json once at startup and never serves mutable dist/.
# Keep this path inside a dedicated command-os-v2 namespace.
# COMMAND_OS_V2_STATIC_RELEASE_ROOT=/var/lib/chillspwn/command-os-v2-static-releases
# Generate a private value of at least 24 bytes. Never place the real token in this file or browser variables.
COMMAND_OS_V2_OPERATOR_TOKEN=
COMMAND_OS_V2_OPERATOR_ID=local-operator
# Set true behind HTTPS. Local HTTP preview deliberately uses a distinct same-site cookie namespace.
COMMAND_OS_V2_SECURE_COOKIES=false
DATABASE_V2=true
EVENT_STREAM_V2=true
SECOND_BRAIN_V2=true
OBSIDIAN_SYNC_V2=false
COMMAND_OS_V2_LEGACY_IMPORT_ROOT=
COMMAND_OS_V2_OBSIDIAN_VAULT_ROOT=
VITE_COMMAND_OS_V2_API_ORIGIN=http://127.0.0.1:43141
