# Root-level recovery safety rules
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example

**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/coverage/
**/htmlcov/
**/*.tsbuildinfo
/chillspwn/plugin/webapp/.gradle/
/chillspwn/plugin/webapp/android/.gradle/
/chillspwn/plugin/webapp/android/build/
/chillspwn/plugin/webapp/android/app/build/
/chillspwn/plugin/webapp/android/app/src/main/assets/
/chillspwn/plugin/webapp/android/capacitor-cordova-android-plugins/build/
/chillspwn/plugin/webapp/dist/
/chillspwn/plugin/webapp/dist-revamp/
/chillspwn/plugin/webapp/logs/
/hermes/runtime/logs/
/hermes/runtime/skills/.usage.json
/hermes/runtime/skills/.curator_state

# Runtime/authentication material must never enter this repository.
**/auth.json*
**/credentials.json*
**/active_sessions.json*
**/state.db*
**/kanban.db*
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/*.log
**/*.out
**/*.ccache
**/*.pfx
**/*.p12
**/*.jks
**/*.keystore
**/*.pem
**/*.crt
**/*.cer
**/*.csr
**/*.key
**/*.keytab
**/*.kirbi
**/*.ovpn
**/*.kdbx
**/id_rsa*
**/id_ed25519*
**/.grok/
**/.codex/
**/sessions/
**/session-logs/
**/shell_snapshots/
**/runtime/events.jsonl
**/client-logs.jsonl
**/llm_raw.jsonl
**/conversation.mcp

# Local verification output.
.gitleaks-report.json
.recovery-test/

# Editor, operating-system, archive, and local build noise.
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/*~
**/*.bak
**/*.bak-*
**/*.pre-phase*
**/*.orig
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.gz
**/*.7z
**/*.rar
**/*.pcap
**/*.pcapng
**/*.apk
**/*.aab
